{
  "dsl": "octos.lesson",
  "version": "0.1",
  "profile": "authoring",
  "lesson": {
    "mode": "explain",
    "language": "zh-CN",
    "title": "光合作用：原料、条件、产物和发生地点",
    "goals": [
      "识别光合作用的原料：二氧化碳和水",
      "理解光和叶绿体是光合作用的重要条件",
      "识别光合作用的产物：葡萄糖和氧气",
      "通过物质流向示意图理解整个过程"
    ],
    "adaptation": {
      "strategies": [
        "用逐步形成的物质流向图组织信息",
        "区分进入反应的物质、反应条件和生成的物质",
        "使用初一学生易理解的生活化语言"
      ],
      "context_refs": [
        "learner_request",
        "required_coverage"
      ]
    }
  },
  "steps": [
    {
      "key": "step-place",
      "purpose": "先建立光合作用发生地点的示意图中心。",
      "beats": [
        {
          "key": "beat-leaf",
          "say": "我们从一片叶开始。叶片是植物进行光合作用的主要器官，接下来所有物质都会围绕它逐步出现。",
          "delivery": "encouraging",
          "actions": [
            {
              "do": "write",
              "when": "during_speech",
              "as": "leaf",
              "kind": "shape",
              "role": "photosynthesis-organ",
              "content": {
                "shape": "leaf",
                "text": "叶片"
              },
              "place": {
                "relation": "new_region",
                "region_role": "main-diagram",
                "align": "center"
              }
            }
          ]
        },
        {
          "key": "beat-chloroplast",
          "say": "把叶片放大来看，叶肉细胞里有叶绿体。光合作用主要发生在叶绿体中，所以叶绿体是这幅示意图的反应场所。",
          "delivery": "careful",
          "actions": [
            {
              "do": "write",
              "when": "during_speech",
              "as": "chloroplast",
              "kind": "shape",
              "role": "reaction-site",
              "content": {
                "shape": "oval",
                "text": "叶绿体",
                "detail": "光合作用的主要发生地点"
              },
              "place": {
                "relation": "inside",
                "anchor": "leaf",
                "align": "center"
              }
            },
            {
              "do": "emphasize",
              "when": "after_speech",
              "target": "chloroplast",
              "emphasis": "highlight-reaction-site"
            }
          ]
        }
      ]
    },
    {
      "key": "step-inputs",
      "purpose": "逐步加入光合作用的两种原料及其流向。",
      "beats": [
        {
          "key": "beat-carbon-dioxide",
          "say": "第一种原料是二氧化碳。它来自空气，通过叶片上的气孔进入叶片，最后到达含有叶绿体的细胞。",
          "delivery": "neutral",
          "actions": [
            {
              "do": "write",
              "when": "during_speech",
              "as": "carbon-dioxide",
              "kind": "text",
              "role": "material-input",
              "content": {
                "text": "二氧化碳（CO₂）",
                "source": "空气",
                "category": "原料"
              },
              "place": {
                "relation": "left_of",
                "anchor": "leaf",
                "align": "center",
                "gap": "spacious"
              }
            },
            {
              "do": "connect",
              "when": "during_speech",
              "as": "carbon-dioxide-flow",
              "from": "carbon-dioxide",
              "to": "chloroplast",
              "relation": "flows-into",
              "label": "从空气进入"
            }
          ]
        },
        {
          "key": "beat-water",
          "say": "第二种原料是水。根从土壤中吸收水，水再沿植物体内的运输结构向上来到叶片和叶绿体。这样，两种原料都进入了反应场所。",
          "delivery": "neutral",
          "actions": [
            {
              "do": "write",
              "when": "during_speech",
              "as": "water",
              "kind": "text",
              "role": "material-input",
              "content": {
                "text": "水（H₂O）",
                "source": "土壤，经根吸收",
                "category": "原料"
              },
              "place": {
                "relation": "below",
                "anchor": "leaf",
                "align": "center",
                "gap": "spacious"
              }
            },
            {
              "do": "connect",
              "when": "during_speech",
              "as": "water-flow",
              "from": "water",
              "to": "chloroplast",
              "relation": "flows-into",
              "label": "由根吸收并向上运输"
            },
            {
              "do": "group",
              "when": "after_speech",
              "as": "raw-materials",
              "role": "input-materials",
              "label": "光合作用的原料",
              "members": [
                "carbon-dioxide",
                "water"
              ]
            },
            {
              "do": "focus",
              "when": "after_speech",
              "targets": [
                "raw-materials",
                "carbon-dioxide-flow",
                "water-flow"
              ],
              "intent": "看清二氧化碳和水都流向叶绿体"
            }
          ]
        }
      ]
    },
    {
      "key": "step-condition",
      "purpose": "加入光这一条件，并明确光不是物质原料。",
      "beats": [
        {
          "key": "beat-light",
          "say": "有了二氧化碳和水还不够，光合作用还需要光。光为反应提供能量；它是条件和能量来源，不是像二氧化碳、水那样进入产物组成的物质原料。",
          "delivery": "careful",
          "actions": [
            {
              "do": "write",
              "when": "during_speech",
              "as": "light",
              "kind": "shape",
              "role": "energy-condition",
              "content": {
                "shape": "sun",
                "text": "光",
                "detail": "提供能量，不属于物质原料"
              },
              "place": {
                "relation": "above",
                "anchor": "leaf",
                "align": "center",
                "gap": "spacious"
              }
            },
            {
              "do": "connect",
              "when": "during_speech",
              "as": "light-energy",
              "from": "light",
              "to": "chloroplast",
              "relation": "provides-energy-to",
              "label": "提供能量"
            },
            {
              "do": "group",
              "when": "after_speech",
              "as": "conditions-and-site",
              "role": "reaction-context",
              "label": "条件与场所",
              "members": [
                "light",
                "chloroplast"
              ]
            },
            {
              "do": "emphasize",
              "when": "after_speech",
              "target": "light-energy",
              "emphasis": "distinguish-energy-from-material-flow"
            }
          ]
        }
      ]
    },
    {
      "key": "step-products",
      "purpose": "加入两种产物，完成光合作用的物质流向示意图。",
      "beats": [
        {
          "key": "beat-glucose",
          "say": "在光提供能量、叶绿体参与的条件下，二氧化碳和水会转化成新的物质。第一种重要产物是葡萄糖，它储存了化学能，可供植物生命活动使用，也能继续转化成其他有机物。",
          "delivery": "neutral",
          "actions": [
            {
              "do": "write",
              "when": "during_speech",
              "as": "glucose",
              "kind": "text",
              "role": "material-output",
              "content": {
                "text": "葡萄糖（C₆H₁₂O₆）",
                "category": "产物",
                "detail": "储存化学能"
              },
              "place": {
                "relation": "right_of",
                "anchor": "chloroplast",
                "align": "start",
                "gap": "spacious"
              }
            },
            {
              "do": "connect",
              "when": "during_speech",
              "as": "glucose-flow",
              "from": "chloroplast",
              "to": "glucose",
              "relation": "produces",
              "label": "生成"
            }
          ]
        },
        {
          "key": "beat-oxygen",
          "say": "另一种产物是氧气。氧气从叶片释放到空气中。现在图中的箭头已经清楚表示：二氧化碳和水流入反应，葡萄糖和氧气从反应中生成。",
          "delivery": "neutral",
          "actions": [
            {
              "do": "write",
              "when": "during_speech",
              "as": "oxygen",
              "kind": "text",
              "role": "material-output",
              "content": {
                "text": "氧气（O₂）",
                "category": "产物",
                "destination": "释放到空气中"
              },
              "place": {
                "relation": "below",
                "anchor": "glucose",
                "align": "start",
                "gap": "normal"
              }
            },
            {
              "do": "connect",
              "when": "during_speech",
              "as": "oxygen-flow",
              "from": "chloroplast",
              "to": "oxygen",
              "relation": "produces",
              "label": "生成并释放"
            },
            {
              "do": "group",
              "when": "after_speech",
              "as": "products",
              "role": "output-materials",
              "label": "光合作用的产物",
              "members": [
                "glucose",
                "oxygen"
              ]
            },
            {
              "do": "focus",
              "when": "after_speech",
              "targets": [
                "raw-materials",
                "chloroplast",
                "products",
                "carbon-dioxide-flow",
                "water-flow",
                "glucose-flow",
                "oxygen-flow"
              ],
              "intent": "呈现原料进入叶绿体并转化为产物的完整物质流向"
            }
          ]
        },
        {
          "key": "beat-overview",
          "say": "把整幅图合起来读：光合作用主要发生在叶绿体中，以二氧化碳和水为原料，需要光提供能量，生成葡萄糖和氧气。可概括为：二氧化碳加水，在光和叶绿体的条件下，生成葡萄糖和氧气。",
          "delivery": "emphatic",
          "actions": [
            {
              "do": "write",
              "when": "during_speech",
              "as": "process-summary",
              "kind": "diagram",
              "role": "photosynthesis-summary",
              "content": {
                "flow": "二氧化碳 + 水 → 葡萄糖 + 氧气",
                "condition": "光",
                "site": "叶绿体",
                "reading": "原料在光和叶绿体的条件下转化为产物"
              },
              "place": {
                "relation": "below",
                "anchor": "water",
                "align": "center",
                "gap": "spacious"
              }
            },
            {
              "do": "group",
              "when": "after_speech",
              "as": "complete-photosynthesis-diagram",
              "role": "complete-process",
              "label": "光合作用完整示意图",
              "members": [
                "leaf",
                "raw-materials",
                "conditions-and-site",
                "products",
                "process-summary"
              ]
            },
            {
              "do": "focus",
              "when": "after_speech",
              "targets": [
                "complete-photosynthesis-diagram",
                "carbon-dioxide-flow",
                "water-flow",
                "light-energy",
                "glucose-flow",
                "oxygen-flow"
              ],
              "intent": "总览光合作用的原料、条件、场所、产物和流向"
            }
          ]
        }
      ]
    }
  ],
  "close": {
    "summary": "光合作用主要发生在叶绿体中。二氧化碳和水是原料，光提供能量，反应生成葡萄糖和氧气；物质流向是二氧化碳和水进入反应，葡萄糖和氧气由反应生成。",
    "focus": [
      "complete-photosynthesis-diagram",
      "carbon-dioxide-flow",
      "water-flow",
      "glucose-flow",
      "oxygen-flow"
    ]
  }
}
