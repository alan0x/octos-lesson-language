{
  "dsl": "octos.lesson",
  "version": "0.1",
  "profile": "authoring",
  "lesson": {
    "mode": "explain",
    "language": "zh-CN",
    "title": "由两点推出直线方程：斜率与截距",
    "goals": [
      "由 A(1,2)、B(4,8) 计算直线斜率",
      "用点斜式写出并化简直线方程",
      "解释斜率和截距的含义"
    ],
    "adaptation": {
      "strategies": [
        "按计算斜率、代入点斜式、化简方程、解释参数的顺序渐进呈现",
        "把符号计算与几何意义对应起来"
      ],
      "context_refs": [
        "learner_request"
      ]
    }
  },
  "steps": [
    {
      "key": "step-points",
      "purpose": "整理两个已知点，并明确横纵坐标的变化量。",
      "beats": [
        {
          "key": "beat-show-points",
          "say": "已知直线经过 A(1,2) 和 B(4,8)。从 A 移到 B，横坐标增加 4-1=3，纵坐标增加 8-2=6。",
          "delivery": "neutral",
          "actions": [
            {
              "do": "write",
              "when": "during_speech",
              "as": "point-a",
              "kind": "math",
              "role": "given-point",
              "content": {
                "latex": "A(1,2)"
              },
              "place": {
                "relation": "new_region",
                "region_role": "derivation",
                "align": "start",
                "gap": "normal"
              }
            },
            {
              "do": "write",
              "when": "during_speech",
              "as": "point-b",
              "kind": "math",
              "role": "given-point",
              "content": {
                "latex": "B(4,8)"
              },
              "place": {
                "relation": "right_of",
                "anchor": "point-a",
                "align": "center",
                "gap": "normal"
              }
            },
            {
              "do": "write",
              "when": "during_speech",
              "as": "coordinate-changes",
              "kind": "math",
              "role": "coordinate-differences",
              "content": {
                "latex": "\\Delta x=4-1=3,\\quad \\Delta y=8-2=6"
              },
              "place": {
                "relation": "below",
                "anchor": "point-a",
                "align": "start",
                "gap": "normal"
              }
            }
          ]
        }
      ]
    },
    {
      "key": "step-slope",
      "purpose": "计算斜率并解释它表示的变化率。",
      "beats": [
        {
          "key": "beat-calculate-slope",
          "say": "斜率等于纵坐标变化量除以横坐标变化量，所以 m=(8-2)/(4-1)=6/3=2。",
          "delivery": "careful",
          "actions": [
            {
              "do": "write",
              "when": "during_speech",
              "as": "slope-calculation",
              "kind": "math",
              "role": "slope-derivation",
              "content": {
                "latex": "m=\\frac{8-2}{4-1}=\\frac{6}{3}=2",
                "text": "m=(8-2)/(4-1)=2"
              },
              "place": {
                "relation": "below",
                "anchor": "coordinate-changes",
                "align": "start",
                "gap": "normal"
              }
            },
            {
              "do": "emphasize",
              "when": "after_speech",
              "target": "slope-calculation",
              "emphasis": "result"
            }
          ]
        },
        {
          "key": "beat-explain-slope",
          "say": "斜率 m=2 表示：沿直线向右移动 1 个单位，纵坐标就上升 2 个单位。因此这条直线从左向右上升。",
          "delivery": "encouraging",
          "actions": [
            {
              "do": "write",
              "when": "during_speech",
              "as": "slope-meaning",
              "kind": "note",
              "role": "concept-explanation",
              "content": {
                "text": "m=2：x 每增加 1，y 增加 2；直线从左向右上升。"
              },
              "place": {
                "relation": "right_of",
                "anchor": "slope-calculation",
                "align": "center",
                "gap": "spacious"
              }
            },
            {
              "do": "point",
              "when": "after_speech",
              "target": "slope-meaning"
            }
          ]
        }
      ]
    },
    {
      "key": "step-equation",
      "purpose": "把斜率和一个已知点代入点斜式，并化简得到直线方程。",
      "beats": [
        {
          "key": "beat-point-slope-form",
          "say": "点斜式是 y-y₁=m(x-x₁)。选用点 A(1,2) 和斜率 m=2，代入得到 y-2=2(x-1)。",
          "delivery": "careful",
          "actions": [
            {
              "do": "write",
              "when": "during_speech",
              "as": "point-slope-template",
              "kind": "math",
              "role": "formula",
              "content": {
                "latex": "y-y_1=m(x-x_1)",
                "label": "点斜式"
              },
              "place": {
                "relation": "new_region",
                "region_role": "equation",
                "align": "start",
                "gap": "normal"
              }
            },
            {
              "do": "write",
              "when": "during_speech",
              "as": "point-slope-substitution",
              "kind": "math",
              "role": "substitution",
              "content": {
                "latex": "y-2=2(x-1)"
              },
              "place": {
                "relation": "below",
                "anchor": "point-slope-template",
                "align": "start",
                "gap": "normal"
              }
            },
            {
              "do": "connect",
              "when": "after_speech",
              "as": "template-to-substitution",
              "from": "point-slope-template",
              "to": "point-slope-substitution",
              "relation": "代入 A(1,2) 与 m=2"
            }
          ]
        },
        {
          "key": "beat-simplify-equation",
          "say": "展开右边，得到 y-2=2x-2；两边同时加 2，最终得到 y=2x。",
          "delivery": "neutral",
          "actions": [
            {
              "do": "write",
              "when": "during_speech",
              "as": "expanded-equation",
              "kind": "math",
              "role": "algebra-step",
              "content": {
                "latex": "y-2=2x-2"
              },
              "place": {
                "relation": "below",
                "anchor": "point-slope-substitution",
                "align": "start",
                "gap": "normal"
              }
            },
            {
              "do": "connect",
              "when": "during_speech",
              "as": "substitution-to-expanded",
              "from": "point-slope-substitution",
              "to": "expanded-equation",
              "relation": "展开"
            },
            {
              "do": "write",
              "when": "during_speech",
              "as": "final-equation",
              "kind": "math",
              "role": "final-result",
              "content": {
                "latex": "y=2x",
                "text": "y=2x"
              },
              "place": {
                "relation": "below",
                "anchor": "expanded-equation",
                "align": "start",
                "gap": "normal"
              }
            },
            {
              "do": "connect",
              "when": "during_speech",
              "as": "expanded-to-final",
              "from": "expanded-equation",
              "to": "final-equation",
              "relation": "两边加 2"
            },
            {
              "do": "emphasize",
              "when": "after_speech",
              "target": "final-equation",
              "emphasis": "final-answer"
            }
          ]
        }
      ]
    },
    {
      "key": "step-intercept",
      "purpose": "从斜截式识别并解释纵截距。",
      "beats": [
        {
          "key": "beat-identify-intercept",
          "say": "斜截式写成 y=mx+b，其中 m 是斜率，b 是纵截距。把 y=2x 写成 y=2x+0，就能看出 b=0。",
          "delivery": "careful",
          "actions": [
            {
              "do": "write",
              "when": "during_speech",
              "as": "slope-intercept-form",
              "kind": "math",
              "role": "formula",
              "content": {
                "latex": "y=mx+b",
                "label": "斜截式"
              },
              "place": {
                "relation": "new_region",
                "region_role": "interpretation",
                "align": "start",
                "gap": "normal"
              }
            },
            {
              "do": "write",
              "when": "during_speech",
              "as": "coefficient-match",
              "kind": "math",
              "role": "parameter-identification",
              "content": {
                "latex": "y=2x+0\\quad\\Rightarrow\\quad m=2,\\ b=0"
              },
              "place": {
                "relation": "below",
                "anchor": "slope-intercept-form",
                "align": "start",
                "gap": "normal"
              }
            },
            {
              "do": "connect",
              "when": "after_speech",
              "as": "form-to-coefficients",
              "from": "slope-intercept-form",
              "to": "coefficient-match",
              "relation": "对应系数"
            }
          ]
        },
        {
          "key": "beat-explain-intercept",
          "say": "纵截距表示直线与 y 轴相交时的 y 坐标，也就是 x=0 时的 y 值。这里代入 x=0 得到 y=0，所以截距为 0，直线经过原点 (0,0)。",
          "delivery": "emphatic",
          "actions": [
            {
              "do": "write",
              "when": "during_speech",
              "as": "intercept-check",
              "kind": "math",
              "role": "intercept-verification",
              "content": {
                "latex": "x=0\\quad\\Rightarrow\\quad y=2\\cdot 0=0"
              },
              "place": {
                "relation": "below",
                "anchor": "coefficient-match",
                "align": "start",
                "gap": "normal"
              }
            },
            {
              "do": "write",
              "when": "during_speech",
              "as": "intercept-meaning",
              "kind": "note",
              "role": "concept-explanation",
              "content": {
                "text": "截距 b=0：直线与 y 轴交于原点 (0,0)。"
              },
              "place": {
                "relation": "right_of",
                "anchor": "intercept-check",
                "align": "center",
                "gap": "spacious"
              }
            },
            {
              "do": "connect",
              "when": "after_speech",
              "as": "check-to-meaning",
              "from": "intercept-check",
              "to": "intercept-meaning",
              "relation": "说明截距"
            },
            {
              "do": "emphasize",
              "when": "after_speech",
              "target": "intercept-meaning",
              "emphasis": "key-conclusion"
            }
          ]
        }
      ]
    },
    {
      "key": "step-summary",
      "purpose": "汇总推导结果及斜率、截距的含义。",
      "beats": [
        {
          "key": "beat-summary",
          "say": "完整推导是：先由两点算出斜率 m=(8-2)/(4-1)=2，再把 A(1,2) 代入点斜式得到 y-2=2(x-1)，化简为 y=2x。斜率 2 表示 x 每增加 1，y 增加 2；截距 0 表示直线经过原点。",
          "delivery": "encouraging",
          "actions": [
            {
              "do": "group",
              "when": "before_speech",
              "as": "derivation-group",
              "role": "final-derivation",
              "label": "从两点到直线方程",
              "members": [
                "slope-calculation",
                "point-slope-substitution",
                "expanded-equation",
                "final-equation"
              ]
            },
            {
              "do": "group",
              "when": "before_speech",
              "as": "meaning-group",
              "role": "parameter-meanings",
              "label": "斜率与截距的含义",
              "members": [
                "slope-meaning",
                "intercept-meaning"
              ]
            },
            {
              "do": "focus",
              "when": "during_speech",
              "targets": [
                "derivation-group",
                "meaning-group"
              ],
              "intent": "回顾方程推导和两个参数的几何意义"
            }
          ]
        }
      ]
    }
  ],
  "close": {
    "summary": "由 A(1,2)、B(4,8) 得到斜率 m=(8-2)/(4-1)=2；代入点斜式 y-2=2(x-1)，化简得 y=2x。斜率 2 表示 x 每增加 1，y 增加 2；纵截距为 0，表示直线经过原点。",
    "focus": [
      "derivation-group",
      "meaning-group"
    ]
  }
}
