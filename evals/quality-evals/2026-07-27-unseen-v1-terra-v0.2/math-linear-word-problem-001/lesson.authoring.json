{
  "dsl": "octos.lesson",
  "version": "0.1",
  "profile": "authoring",
  "lesson": {
    "mode": "explain",
    "language": "zh-CN",
    "title": "出租车计价：8公里费用与通用分段函数",
    "goals": [
      "区分起步里程和超出里程",
      "算出乘坐8公里的费用",
      "建立出租车费用关于里程的分段函数"
    ],
    "adaptation": {
      "strategies": [
        "先拆分里程，再计算费用",
        "用逐步出现的算式连接具体问题与通用函数"
      ],
      "context_refs": [
        "learner_request"
      ]
    }
  },
  "steps": [
    {
      "key": "understand-pricing",
      "purpose": "明确13元覆盖的起步里程，以及只有超出部分按每公里2.3元计费。",
      "beats": [
        {
          "key": "show-base-rule",
          "say": "计价规则的第一部分是：13元起步价已经包含前3公里。",
          "delivery": "careful",
          "actions": [
            {
              "do": "write",
              "when": "during_speech",
              "as": "base-rule",
              "kind": "text",
              "role": "pricing-rule",
              "content": {
                "text": "起步价：13元，包含前3公里"
              },
              "place": {
                "relation": "new_region",
                "region_role": "main-board",
                "align": "start",
                "gap": "normal"
              }
            }
          ]
        },
        {
          "key": "show-extra-rule",
          "say": "第二部分是：超过3公里以后，只对超出的里程按每公里2.3元收费。",
          "delivery": "emphatic",
          "actions": [
            {
              "do": "write",
              "when": "during_speech",
              "as": "extra-rule",
              "kind": "text",
              "role": "pricing-rule",
              "content": {
                "text": "超出3公里的部分：每公里2.3元"
              },
              "place": {
                "relation": "below",
                "anchor": "base-rule",
                "align": "start",
                "gap": "compact"
              }
            },
            {
              "do": "emphasize",
              "when": "after_speech",
              "target": "extra-rule",
              "emphasis": "突出“超出3公里的部分”"
            }
          ]
        }
      ]
    },
    {
      "key": "split-eight-kilometers",
      "purpose": "把8公里拆成起步里程和超出里程，避免把全部8公里重复计费。",
      "beats": [
        {
          "key": "identify-total-distance",
          "say": "这次一共乘坐8公里，其中前3公里已经包含在13元起步价里。",
          "delivery": "careful",
          "actions": [
            {
              "do": "write",
              "when": "during_speech",
              "as": "total-distance",
              "kind": "math",
              "role": "given-distance",
              "content": {
                "latex": "8\\text{公里}=3\\text{公里}+\\text{超出里程}"
              },
              "place": {
                "relation": "new_region",
                "region_role": "worked-example",
                "align": "start",
                "gap": "normal"
              }
            }
          ]
        },
        {
          "key": "calculate-extra-distance",
          "say": "所以超出里程不是8公里，而是8减3，等于5公里。",
          "delivery": "emphatic",
          "actions": [
            {
              "do": "write",
              "when": "during_speech",
              "as": "extra-distance",
              "kind": "math",
              "role": "distance-calculation",
              "content": {
                "latex": "8-3=5\\text{公里}"
              },
              "place": {
                "relation": "below",
                "anchor": "total-distance",
                "align": "start",
                "gap": "compact"
              }
            },
            {
              "do": "connect",
              "when": "after_speech",
              "as": "total-to-extra",
              "from": "total-distance",
              "to": "extra-distance",
              "relation": "扣除起步里程得到超出里程",
              "label": "8-3"
            },
            {
              "do": "emphasize",
              "when": "after_speech",
              "target": "extra-distance",
              "emphasis": "突出5公里是按2.3元计费的里程"
            }
          ]
        }
      ]
    },
    {
      "key": "calculate-eight-kilometer-fare",
      "purpose": "根据起步价加超出里程费用，算出8公里的应付金额。",
      "beats": [
        {
          "key": "build-fare-expression",
          "say": "总费用等于13元起步价，加上5公里超出里程的费用，因此算式是13加2.3乘以8减3。",
          "delivery": "careful",
          "actions": [
            {
              "do": "write",
              "when": "during_speech",
              "as": "fare-expression",
              "kind": "math",
              "role": "fare-calculation",
              "content": {
                "latex": "13+2.3\\times(8-3)"
              },
              "place": {
                "relation": "right_of",
                "anchor": "extra-distance",
                "align": "center",
                "gap": "normal"
              }
            },
            {
              "do": "connect",
              "when": "after_speech",
              "as": "extra-to-fare",
              "from": "extra-distance",
              "to": "fare-expression",
              "relation": "超出里程乘以每公里单价",
              "label": "2.3元/公里"
            }
          ]
        },
        {
          "key": "finish-fare-calculation",
          "say": "先算8减3得到5，再算2.3乘5得到11.5，最后加上13，结果是24.5元。",
          "delivery": "encouraging",
          "actions": [
            {
              "do": "write",
              "when": "during_speech",
              "as": "fare-result",
              "kind": "math",
              "role": "worked-result",
              "content": {
                "latex": "13+2.3\\times5=13+11.5=24.5\\text{元}"
              },
              "place": {
                "relation": "below",
                "anchor": "fare-expression",
                "align": "start",
                "gap": "compact"
              }
            },
            {
              "do": "emphasize",
              "when": "after_speech",
              "target": "fare-result",
              "emphasis": "突出最终结果24.5元"
            }
          ]
        }
      ]
    },
    {
      "key": "build-general-function",
      "purpose": "把具体的8公里计算推广为任意非负里程的分段函数。",
      "beats": [
        {
          "key": "define-variables",
          "say": "设行驶里程为x公里，且x不小于0；设应付费用为f(x)元。",
          "delivery": "neutral",
          "actions": [
            {
              "do": "write",
              "when": "during_speech",
              "as": "variable-definition",
              "kind": "math",
              "role": "variable-definition",
              "content": {
                "latex": "x\\ge 0\\text{：行驶里程（公里）},\\quad f(x)\\text{：费用（元）}"
              },
              "place": {
                "relation": "new_region",
                "region_role": "generalization",
                "align": "start",
                "gap": "normal"
              }
            }
          ]
        },
        {
          "key": "write-first-branch",
          "say": "当0到3公里，也就是0小于等于x且x小于等于3时，费用都由起步价覆盖，所以f(x)等于13。",
          "delivery": "careful",
          "actions": [
            {
              "do": "write",
              "when": "during_speech",
              "as": "base-branch",
              "kind": "math",
              "role": "function-branch",
              "content": {
                "latex": "f(x)=13,\\quad 0\\le x\\le 3"
              },
              "place": {
                "relation": "below",
                "anchor": "variable-definition",
                "align": "start",
                "gap": "compact"
              }
            },
            {
              "do": "connect",
              "when": "after_speech",
              "as": "base-rule-to-branch",
              "from": "base-rule",
              "to": "base-branch",
              "relation": "起步价对应不超过3公里的函数分支"
            }
          ]
        },
        {
          "key": "write-second-branch",
          "say": "当x大于3时，超出里程是x减3，所以费用是13加2.3乘以x减3。",
          "delivery": "careful",
          "actions": [
            {
              "do": "write",
              "when": "during_speech",
              "as": "extra-branch",
              "kind": "math",
              "role": "function-branch",
              "content": {
                "latex": "f(x)=13+2.3(x-3),\\quad x>3"
              },
              "place": {
                "relation": "below",
                "anchor": "base-branch",
                "align": "start",
                "gap": "compact"
              }
            },
            {
              "do": "connect",
              "when": "after_speech",
              "as": "extra-rule-to-branch",
              "from": "extra-rule",
              "to": "extra-branch",
              "relation": "超出部分计价对应大于3公里的函数分支"
            }
          ]
        },
        {
          "key": "assemble-piecewise-function",
          "say": "合在一起，通用计价函数是分段函数：不超过3公里收13元，超过3公里收13加2.3乘以超出里程x减3。",
          "delivery": "emphatic",
          "actions": [
            {
              "do": "write",
              "when": "during_speech",
              "as": "piecewise-function",
              "kind": "math",
              "role": "final-function",
              "content": {
                "latex": "f(x)=\\begin{cases}13,&0\\le x\\le3\\\\13+2.3(x-3),&x>3\\end{cases}"
              },
              "place": {
                "relation": "right_of",
                "anchor": "base-branch",
                "align": "center",
                "gap": "spacious"
              }
            },
            {
              "do": "group",
              "when": "after_speech",
              "as": "function-group",
              "role": "piecewise-model",
              "label": "出租车通用计价函数",
              "members": [
                "variable-definition",
                "base-branch",
                "extra-branch",
                "piecewise-function"
              ]
            }
          ]
        },
        {
          "key": "verify-eight-kilometers",
          "say": "因为8大于3，要使用第二段；代入x等于8，就得到f(8)等于13加2.3乘以8减3，等于24.5元。",
          "delivery": "encouraging",
          "actions": [
            {
              "do": "write",
              "when": "during_speech",
              "as": "function-check",
              "kind": "math",
              "role": "substitution-check",
              "content": {
                "latex": "f(8)=13+2.3(8-3)=24.5\\text{元}"
              },
              "place": {
                "relation": "below",
                "anchor": "piecewise-function",
                "align": "start",
                "gap": "normal"
              }
            },
            {
              "do": "connect",
              "when": "after_speech",
              "as": "function-to-check",
              "from": "piecewise-function",
              "to": "function-check",
              "relation": "将x等于8代入大于3公里的分支"
            },
            {
              "do": "focus",
              "when": "after_speech",
              "targets": [
                "function-group",
                "function-check"
              ],
              "intent": "同时聚焦通用分段函数和8公里的24.5元结果"
            }
          ]
        }
      ]
    }
  ],
  "close": {
    "summary": "前3公里包含在13元起步价中，超过3公里的部分才按每公里2.3元收费。乘坐8公里时，超出里程是8-3=5公里，所以费用为13+2.3×(8-3)=24.5元。通用函数为f(x)=13（0≤x≤3），f(x)=13+2.3(x-3)（x>3）。",
    "focus": [
      "fare-result",
      "function-group",
      "function-check"
    ]
  }
}
