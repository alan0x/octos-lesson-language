{
  "name": "octos-lesson-language",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/packages/core/test/*.test.js dist/packages/eval-runner/test/*.test.js",
    "check:examples": "npm run build && node dist/packages/core/src/check-examples.js",
    "generate:goldens": "npm run build && node dist/packages/core/src/generate-goldens.js",
    "eval": "npm run build && node dist/packages/eval-runner/src/cli.js"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
