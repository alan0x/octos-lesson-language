{
  "name": "octos-lesson-language",
  "version": "0.1.0-rc.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:harness",
    "build:harness": "esbuild apps/playback-harness/src/app.ts --bundle --format=esm --platform=browser --target=es2022 --sourcemap --loader:.woff2=file --loader:.woff=file --loader:.ttf=file --asset-names=assets/[name]-[hash] --outfile=dist/apps/playback-harness/browser/app.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/packages/core/test/*.test.js dist/packages/eval-runner/test/*.test.js dist/packages/player-core/test/*.test.js dist/packages/quality-runner/test/*.test.js dist/apps/playback-harness/test/*.test.js",
    "check:examples": "npm run build && node dist/packages/core/src/check-examples.js",
    "generate:goldens": "npm run build && node dist/packages/core/src/generate-goldens.js",
    "eval": "npm run build && node dist/packages/eval-runner/src/cli.js",
    "eval:revalidate": "npm run build && node dist/packages/eval-runner/src/revalidate.js",
    "playback:conformance": "npm run build && node dist/packages/player-core/src/check-runs.js",
    "quality:eval": "npm run build && node dist/packages/quality-runner/src/cli.js",
    "harness:dev": "npm run build && node scripts/serve-playback-harness.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/packages/core/src/index.d.ts",
      "default": "./dist/packages/core/src/index.js"
    },
    "./player": {
      "types": "./dist/packages/player-core/src/index.d.ts",
      "default": "./dist/packages/player-core/src/index.js"
    }
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "katex": "^0.18.1"
  }
}
