{"dsl":"octos.lesson","version":"0.1","profile":"canonical","event":"lesson.step","lesson_id":"lesson-learner-taught-box-v1-001","sequence":1,"step":{"id":"lesson-learner-taught-box-v1-001:step:teach-surface-area","purpose":"Morgan shows each pair of faces of a box and adds their areas","beats":[{"id":"lesson-learner-taught-box-v1-001:step:teach-surface-area:beat:card-1-the-box","narration":{"text":"This box is 4 long, 3 wide and 2 tall. Surface area means the area of all six faces."},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-learner-taught-box-v1-001:action:1:1:1","op":"board.create","node":{"id":"lesson-learner-taught-box-v1-001:node:box","kind":"scene3d","role":"diagram","content":{"title":"A 4 × 3 × 2 box","fallback":"A rectangular box 4 units long, 3 wide and 2 tall.","axes":false,"camera":{"yaw":0.72,"pitch":0.55,"zoom":1},"objects":[{"id":"lesson-learner-taught-box-v1-001:node:box:fragment:prism","kind":"box","label":"box","center":{"x":0,"y":0,"z":1},"size":{"x":4,"y":3,"z":2}}],"highlights":[{"id":"lesson-learner-taught-box-v1-001:node:box:fragment:top-face","kind":"face","label":"top 4 × 3","points":[{"x":-2,"y":-1.5,"z":2},{"x":2,"y":-1.5,"z":2},{"x":2,"y":1.5,"z":2},{"x":-2,"y":1.5,"z":2}]},{"id":"lesson-learner-taught-box-v1-001:node:box:fragment:bottom-face","kind":"face","label":"bottom 4 × 3","points":[{"x":-2,"y":-1.5,"z":0},{"x":2,"y":-1.5,"z":0},{"x":2,"y":1.5,"z":0},{"x":-2,"y":1.5,"z":0}]},{"id":"lesson-learner-taught-box-v1-001:node:box:fragment:front-face","kind":"face","label":"front 4 × 2","points":[{"x":-2,"y":-1.5,"z":0},{"x":2,"y":-1.5,"z":0},{"x":2,"y":-1.5,"z":2},{"x":-2,"y":-1.5,"z":2}]},{"id":"lesson-learner-taught-box-v1-001:node:box:fragment:side-face","kind":"face","label":"side 3 × 2","points":[{"x":2,"y":-1.5,"z":0},{"x":2,"y":1.5,"z":0},{"x":2,"y":1.5,"z":2},{"x":2,"y":-1.5,"z":2}]}]},"placement":{"relation":"new_region","region_role":"lesson-origin"}}},{"action_id":"lesson-learner-taught-box-v1-001:action:1:1:2","op":"board.emphasize","target":{"node_id":"lesson-learner-taught-box-v1-001:node:box","fragment_id":"lesson-learner-taught-box-v1-001:node:box:fragment:top-face"},"emphasis":"focus"}],"after_speech":[{"action_id":"lesson-learner-taught-box-v1-001:action:1:1:3","op":"board.focus","focus":{"targets":["lesson-learner-taught-box-v1-001:node:box"],"intent":"introduce_box"}}]}},{"id":"lesson-learner-taught-box-v1-001:step:teach-surface-area:beat:card-2-the-bottom","narration":{"text":"Turn it over. The bottom is a 4 by 3 rectangle, the same as the top. That's 12 twice."},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-learner-taught-box-v1-001:action:1:2:1","op":"scene3d.view","target":{"node_id":"lesson-learner-taught-box-v1-001:node:box"},"view":{"show":{"node_id":"lesson-learner-taught-box-v1-001:node:box","fragment_id":"lesson-learner-taught-box-v1-001:node:box:fragment:bottom-face"}}},{"action_id":"lesson-learner-taught-box-v1-001:action:1:2:2","op":"board.emphasize","target":{"node_id":"lesson-learner-taught-box-v1-001:node:box","fragment_id":"lesson-learner-taught-box-v1-001:node:box:fragment:bottom-face"},"emphasis":"focus"}],"after_speech":[{"action_id":"lesson-learner-taught-box-v1-001:action:1:2:3","op":"board.focus","focus":{"targets":["lesson-learner-taught-box-v1-001:node:box"],"intent":"show_bottom_face"}}]}},{"id":"lesson-learner-taught-box-v1-001:step:teach-surface-area:beat:card-3-the-front","narration":{"text":"From the front, this face is 4 by 2, so 8. The back is the same."},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-learner-taught-box-v1-001:action:1:3:1","op":"scene3d.view","target":{"node_id":"lesson-learner-taught-box-v1-001:node:box"},"view":{"preset":"front"}},{"action_id":"lesson-learner-taught-box-v1-001:action:1:3:2","op":"board.emphasize","target":{"node_id":"lesson-learner-taught-box-v1-001:node:box","fragment_id":"lesson-learner-taught-box-v1-001:node:box:fragment:front-face"},"emphasis":"focus"}],"after_speech":[{"action_id":"lesson-learner-taught-box-v1-001:action:1:3:3","op":"board.focus","focus":{"targets":["lesson-learner-taught-box-v1-001:node:box"],"intent":"show_front_face"}}]}},{"id":"lesson-learner-taught-box-v1-001:step:teach-surface-area:beat:card-4-add-them-up","narration":{"text":"The two sides are 3 by 2, so 6 each. Add all six: 24 plus 16 plus 12 is 52."},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-learner-taught-box-v1-001:action:1:4:1","op":"scene3d.view","target":{"node_id":"lesson-learner-taught-box-v1-001:node:box"},"view":{"preset":"isometric"}},{"action_id":"lesson-learner-taught-box-v1-001:action:1:4:2","op":"board.create","node":{"id":"lesson-learner-taught-box-v1-001:node:total","kind":"math","role":"conclusion","content":{"fragments":[{"id":"lesson-learner-taught-box-v1-001:node:total:fragment:pairs","latex":"2(4\\cdot3)+2(4\\cdot2)+2(3\\cdot2)"},{"id":"lesson-learner-taught-box-v1-001:node:total:fragment:result","latex":"=24+16+12=52"}]},"placement":{"relation":"below","align":"start","gap":"normal","anchor":"lesson-learner-taught-box-v1-001:node:box"}}}],"after_speech":[{"action_id":"lesson-learner-taught-box-v1-001:action:1:4:3","op":"board.focus","focus":{"targets":["lesson-learner-taught-box-v1-001:node:total"],"intent":"add_faces"}}]}}]}}
