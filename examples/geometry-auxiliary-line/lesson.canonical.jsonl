{"dsl":"octos.lesson","version":"0.1","profile":"canonical","event":"lesson.step","lesson_id":"lesson-geometry-001","sequence":3,"step":{"id":"lesson-geometry-001:step:construct-auxiliary-line","purpose":"解释连接 AD 的动机和它创造的两个三角形","beats":[{"id":"lesson-geometry-001:step:construct-auxiliary-line:beat:draw-ad","narration":{"text":"现在连接 A 和 D。它不是凭空出现的技巧：这条线把大三角形分成了 △ABD 和 △ACD，让两边的已知相等条件进入两个可比较的三角形。","delivery":"emphatic"},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-geometry-001:action:3:1:1","op":"board.connect","connection":{"id":"lesson-geometry-001:connection:auxiliary-ad","from":{"node_id":"lesson-geometry-001:node:clean-diagram","fragment_id":"lesson-geometry-001:node:clean-diagram:fragment:point-a"},"to":{"node_id":"lesson-geometry-001:node:clean-diagram","fragment_id":"lesson-geometry-001:node:clean-diagram:fragment:point-d"},"relation":"geometry_segment","label":"辅助线 AD"}},{"action_id":"lesson-geometry-001:action:3:1:2","op":"board.emphasize","target":{"connection_id":"lesson-geometry-001:connection:auxiliary-ad"},"emphasis":"focus"},{"action_id":"lesson-geometry-001:action:3:1:3","op":"board.emphasize","target":{"node_id":"lesson-geometry-001:node:clean-diagram","fragment_id":"lesson-geometry-001:node:clean-diagram:fragment:triangle-abd"},"emphasis":"supporting"},{"action_id":"lesson-geometry-001:action:3:1:4","op":"board.emphasize","target":{"node_id":"lesson-geometry-001:node:clean-diagram","fragment_id":"lesson-geometry-001:node:clean-diagram:fragment:triangle-acd"},"emphasis":"supporting"}],"after_speech":[]}},{"id":"lesson-geometry-001:step:construct-auxiliary-line:beat:state-motive","narration":{"text":"选择连接顶点 A 和中点 D，是因为它同时提供公共边 AD，并把底边中点条件变成 BD 等于 DC。","delivery":"careful"},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-geometry-001:action:3:2:1","op":"board.create","node":{"id":"lesson-geometry-001:node:construction-motive","kind":"note","role":"observation","content":{"title":"为什么连 AD","items":["产生公共边 AD","把 BD