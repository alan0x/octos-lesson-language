-congruence","narration":{"text":"因此根据 SSS，△ABD 全等于 △ACD。辅助线的任务完成了：它把原来分散的条件组织成了一次全等证明。","delivery":"emphatic"},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-geometry-001:action:4:2:1","op":"board.create","node":{"id":"lesson-geometry-001:node:congruence-result","kind":"math","role":"conclusion","content":{"fragments":[{"id":"lesson-geometry-001:node:congruence-result:fragment:statement","latex":"\\triangle ABD\\cong\\triangle ACD"},{"id":"lesson-geometry-001:node:congruence-result:fragment:reason","latex":"\\quad(SSS)"}]},"placement":{"relation":"below","align":"start","gap":"normal","anchor":"lesson-geometry-001:node:sss-table"}}}],"after_speech":[]}}]}}
