:node:section-01-moment-01-item-01:fragment:row-5-right.y","expression":"((5)+(number_02)-abs((5)-(number_02)))/2"},{"target":"rectangle-area-from-tiles-0.1.5:node:section-01-moment-01-item-01:fragment:row-6-left.y","expression":"((6)+(number_02)-abs((6)-(number_02)))/2"},{"target":"rectangle-area-from-tiles-0.1.5:node:section-01-moment-01-item-01:fragment:row-6-right.x","expression":"number_01"},{"target":"rectangle-area-from-tiles-0.1.5:node:section-01-moment-01-item-01:fragment:row-6-right.y","expression":"((6)+(number_02)-abs((6)-(number_02)))/2"},{"target":"rectangle-area-from-tiles-0.1.5:node:section-01-moment-01-item-01:fragment:row-7-left.y","expression":"((7)+(number_02)-abs((7)-(number_02)))/2"},{"target":"rectangle-area-from-tiles-0.1.5:node:section-01-moment-01-item-01:fragment:row-7-right.x","expression":"number_01"},{"target":"rectangle-area-from-tiles-0.1.5:node:section-01-moment-01-item-01:fragment:row-7-right.y","expression":"((7)+(number_02)-abs((7)-(number_02)))/2"},{"target":"rectangle-area-from-tiles-0.1.5:node:section-01-moment-01-item-01:fragment:row-8-left.y","expression":"((8)+(number_02)-abs((8)-(number_02)))/2"},{"target":"rectangle-area-from-tiles-0.1.5:node:section-01-moment-01-item-01:fragment:row-8-right.x","expression":"number_01"},{"target":"rectangle-area-from-tiles-0.1.5:node:section-01-moment-01-item-01:fragment:row-8-right.y","expression":"((8)+(number_02)-abs((8)-(number_02)))/2"}]},"placement":{"relation":"new_region","region_role":"section-01"},"region_id":"rectangle-area-from-tiles-0.1.5-region"}},{"action_id":"rectangle-area-from-tiles-0.1.5:action:1:1:3","op":"board.focus","focus":{"targets":["rectangle-area-from-tiles-0.1.5:node:section-01-moment-01-item-01"],"intent":"展示由1平方厘米的小正方形平铺覆盖长方形区域"}}],"during_speech":[{"action_id":"rectangle-area-from-tiles-0.1.5:action:1:1:2","op":"board.create","node":{"id":"rectangle-area-from-tiles-0.1.5:node:section-01-moment-01-item-02","kind":"note","role":"explanation","content":{"title":"面积的概念","items":["面积表示平面图形所占用平面区域的大小。","常用边长为1厘米的正方形作为基本度量单位（1平方厘米）。"]},"placement":{"relation":"below","anchor":"rectangle-area-from-tiles-0.1.5:node:section-01-moment-01-item-01"},"region_id":"rectangle-area-from-tiles-0.1.5-region"}}],"after_speech":[]}},{"id":"rectangle-area-from-tiles-0.1.5:step:section-01:beat:moment-02","narration":{"text":"比如眼前这个长方形，就是由边长为1厘米的小正方形紧密排列组成的。通过统计一共用了多少个1平方厘米的小方格，我们就能准确算出它的面积。","delivery":"encouraging"},"stage":{"before_speech":[],"during_speech":[{"action_id":"rectangle-area-from-tiles-0.1.5:action:1:2:1","op":"teacher.point","target":{"node_id":"rectangle-area-from-tiles-0.1.5:node:section-01-moment-01-item-01"}}],"after_speech":[]}}]}}
{"dsl":"octos.lesson","version":"0.1","profile":"canonical","event":"lesson.step","lesson_id":"rectangle-area-from-tiles-0.1.5","sequence":2,"step":{"id":"rectangle-area-from-tiles-0.1.5:step:section-02","purpose":"通过每行方格数和行数的阵列排列发现方格总数规律","beats":[{"id":"rectangle-area-from-tiles-0.1.5:step:section-02:beat:moment-01","narration":{"text":"现在我们来看这个长方形。它被1平方厘米的小正方形格子完全铺满。观察它的横向排列，每行正好包含4个小方格。","delivery":"patient"},"stage":{"before_speech":[],"during_speech":[{"action_id":"rectangle-area-from-tiles-0.1.5:action:2:1:1","op":"teacher.point","target":{"node_id":"rectangle-area-from-tiles-0.1.5:node:section-01-moment-01-item-01"}}],"after_speech":[]}},{"id":"rectangle-area-from-tiles-0.1.5:step:section-02:beat:moment-02","narration":{"text":"接着看纵向排列，这样的行一共有3行。要求出方格的总数，就是把这3行、每行4个的方格加起来。","delivery":"patient"},"stage":{"before_speech":[],"during_speech":[{"action_id":"rectangle-area-from-tiles-0.1.5:action:2:2:1","op":"teacher.expression","expression":"neutral"}],"after_speech":[]}},{"id":"rectangle-area-from-tiles-0.1.5:step:section-02:beat:moment-03","narration":{"text":"根据乘法的意义，每行4个方格，乘以3行，总共就是 4 乘以 3 等于 12 个方格。因此方格总数等于每行方格数乘以行数。","delivery":"emphatic"},"stage":{"before_speech":[],"during_speech":[{"action_id":"rectangle-area-from-tiles-0.1.5:action:2:3:1","op":"board.create","node":{"id":"rectangle-area-from-tiles-0.1.5:node:section-02-moment-03-item-01","kind":"math","role":"derivation","content":{"latex":"\\text{方格总数} = \\text{每行方格数} \\times \\text{行数} = 4 \\times 3 = 12"},"placement":{"relation":"below","anchor":"rectangle-area-from-tiles-0.1.5:node:section-01-moment-01-item-01"},"region_id":"rectangle-area-from-tiles-0.1.5-region"}},{"action_id":"rectangle-area-from-tiles-0.1.5:action:2:3:2","op":"board.focus","focus":{"targets":["rectangle-area-from-tiles-0.1.5:node:section-01-moment-01-item-01","rectangle-area-from-tiles-0.1.5:node:section-02-moment-03-item-01"],"intent":"强调方格总数与每行方格数、行数的乘积关系"}}],"after_speech":[]}}]}}
{"dsl":"octos.lesson","version":"0.1","profile":"canonical","event":"lesson.step","lesson_id":"rectangle-area-from-tiles-0.1.5","sequence":3,"step":{"id":"rectangle-area-from-tiles-0.1.5:step:section-03","purpose":"推导长方形面积公式并应用平方单位","beats":[{"id":"rectangle-area-from-tiles-0.1.5:step:section-03:beat:moment-01","narration":{"text":"在上一步中，我们发现把单位正方形排成阵列，总方格数就是每行的个数乘以行数。现在，我们把这种规律抽象为通用的长方形面积计算公式。","delivery":"patient"},"stage":{"before_speech":[],"during_speech":[{"action_id":"rectangle-area-from-tiles-0.1.5:action:3:1:1","op":"teacher.expression","expression":"neutral"}],"after_speech":[]}},{"id":"rectangle-area-from-tiles-0.1.5:step:section-03:beat:moment-02","narration":{"text":"对于一个长方形，如果长是4厘米，意味着每行可以铺4个1平方厘米的正方形；宽是3厘米，表示可以铺3行。因此，总面积就是每行4个乘以3行，得到12平方厘米。","delivery":"neutral"},"stage":{"before_speech":[],"during_speech":[{"action_id":"rectangle-area-from-tiles-0.1.5:action:3:2:1","op":"lesson.variable.animate","animation":{"variable":"number_01","to":4,"easing":"linear","duration_intent":"brief"}},{"action_id":"rectangle-area-from-tiles-0.1.5:action:3:2:2","op":"lesson.variable.animate","animation":{"variable":"number_02","to":3,"easing":"linear","duration_intent":"brief"}}],"after_speech":[]}},{"id":"rectangle-area-from-tiles-0.1.5:step:section-03:beat:moment-03","narration":{"text":"把这个规律写成公式，就是：长方形的面积等于长乘以宽。用字母表示，通常写作 S 等于 a 乘以 b。","delivery":"emphatic"},"stage":{"before_speech":[],"during_speech":[{"action_id":"rectangle-area-from-tiles-0.1.5:action:3:3:1","op":"board.create","node":{"id":"rectangle-area-from-tiles-0.1.5:node:section-03-moment-03-item-01","kind":"math","role":"derivation","content":{"latex":"S = a \\times b = 4 \\text{ cm} \\times 3 \\text{ cm} = 12 \\text{ cm}^2"},"placement":{"relation":"below","anchor":"rectangle-area-from-tiles-0.1.5:node:section-02-moment-03-item-01"},"region_id":"rectangle-area-from-tiles-0.1.5-region"}},{"action_id":"rectangle-area-from-tiles-0.1.5:action:3:3:2","op":"board.focus","focus":{"targets":["rectangle-area-from-tiles-0.1.5:node:section-01-moment-01-item-01","rectangle-area-from-tiles-0.1.5:node:section-03-moment-03-item-01"],"intent":"重点展示长方形面积公式"}}],"after_speech":[]}},{"id":"rectangle-area-from-tiles-0.1.5:step:section-03:beat:moment-04","narration":{"text":"请注意单位的使用：长度的单位是厘米，而面积表示覆盖的单位正方形数量，必须使用平方厘米。如果长度单位是米，面积单位就是平方米。","delivery":"encouraging"},"stage":{"before_speech":[],"during_speech":[{"action_id":"rectangle-area-from-tiles-0.1.5:action:3:4:1","op":"teacher.expression","expression":"neutral"}],"after_speech":[]}}]}}
{"dsl":"octos.lesson","version":"0.1","profile":"canonical","event":"lesson.step","lesson_id":"rectangle-area-from-tiles-0.1.5","sequence":4,"step":{"id":"rectangle-area-from-tiles-0.1.5:step:section-04","purpose":"对比长方形的面积与周长，明确概念区别","beats":[{"id":"rectangle-area-from-tiles-0.1.5:step:section-04:beat:moment-01","narration":{"text":"现在我们来对比长方形的面积与周长。以长4厘米、宽3厘米的长方形为例，周长是围成它的四条边的总长度。","delivery":"patient"},"stage":{"before_speech":[],"during_speech":[{"action_id":"rectangle-area-from-tiles-0.1.5:action:4:1:1","op":"teacher.expression","expression":"neutral"}],"after_speech":[]}},{"id":"rectangle-area-from-tiles-0.1.5:step:section-04:beat:moment-02","narration":{"text":"计算周长时，我们将四条边相加：4加3加4加3，得到14厘米。周长表示边缘的长度，单位是长度单位厘米。","delivery":"neutral"},"stage":{"before_speech":[],"during_speech":[],"after_speech":[{"action_id":"rectangle-area-from-tiles-0.1.5:action:4:2:1","op":"teacher.expression","expression":"neutral"}]}},{"id":"rectangle-area-from-tiles-0.1.5:step:section-04:beat:moment-03","narration":{"text":"而面积表示长方形内部所占平面的大小。通过前面学习的方格阵列，长4厘米、宽3厘米包含4乘3等于12个1平方厘米的单位正方形，所以面积是12平方厘米。","delivery":"emphatic"},"stage":{"before_speech":[],"during_speech":[{"action_id":"rectangle-area-from-tiles-0.1.5:action:4:3:1","op":"teacher.expression","expression":"neutral"}],"after_speech":[]}},{"id":"rectangle-area-from-tiles-0.1.5:step:section-04:beat:moment-04","narration":{"text":"总结一下：周长是围成图形一圈的长度，用长度单位厘米；面积是图形所占面的大小，用面积单位平方厘米。两者概念和单位都完全不同。","delivery":"encouraging"},"stage":{"before_speech":[],"during_speech":[{"action_id":"rectangle-area-from-tiles-0.1.5:action:4:4:1","op":"board.create","node":{"id":"rectangle-area-from-tiles-0.1.5:node:section-04-moment-04-item-01","kind":"note","role":"explanation","content":{"title":"面积与周长的区别","items":["周长：围成图形四周边界的总长度（单位：厘米）","周长计算：(4 + 3) × 2 = 14 厘米","面积：图形所占平面区域的大小（单位：平方厘米）","面积计算：4 × 3 = 12 平方厘米"]},"placement":{"relation":"below","anchor":"rectangle-area-from-tiles-0.1.5:node:section-03-moment-03-item-01"},"region_id":"rectangle-area-from-tiles-0.1.5-region"}}],"after_speech":[{"action_id":"rectangle-area-from-tiles-0.1.5:action:4:4:2","op":"board.focus","focus":{"targets":["rectangle-area-from-tiles-0.1.5:node:section-01-moment-01-item-01","rectangle-area-from-tiles-0.1.5:node:section-04-moment-04-item-01"],"intent":"对比周长与面积的区别总结"}}]}}]}}
{"dsl":"octos.lesson","version":"0.1","profile":"canonical","event":"lesson.close","lesson_id":"rectangle-area-from-tiles-0.1.5","sequence":5,"result":{"summary":"本课程从边长为1厘米的单位正方形平铺出发，帮助学生建立了面积的直观概念；通过行列计数推导出长方形面积公式“长×宽”，并明确了平方厘米等面积单位与厘米等长度单位的区别。","summary_node_refs":[],"suggested_focus":["rectangle-area-from-tiles-0.1.5:node:section-01-moment-01-item-01"]}}
