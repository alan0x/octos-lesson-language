 the slope is 6 over 3, which is 2."},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-learner-taught-slope-v2-001:action:1:3:1","op":"board.create","node":{"id":"lesson-learner-taught-slope-v2-001:node:ink-fraction","kind":"ink","role":"derivation","content":{"snapshot_id":"ink-snap:card3@v4","sha256":"a637f0197d070fc324ef0c11eacec0ff7b3bfab4b3fbd9b7fce6fdf065cdc632","replay":"stroke_order","alt":"Jordan's handwritten fraction: 8 minus 2 over 4 minus 1","selections":[{"id":"lesson-learner-taught-slope-v2-001:node:ink-fraction:fragment:rise","selection_id":"sel-card3-rise","label":"8 − 2"},{"id":"lesson-learner-taught-slope-v2-001:node:ink-fraction:fragment:run","selection_id":"sel-card3-run","label":"4 − 1"}]},"placement":{"relation":"below","align":"start","gap":"normal","anchor":"lesson-learner-taught-slope-v2-001:node:grid"}}},{"action_id":"lesson-learner-taught-slope-v2-001:action:1:3:2","op":"board.emphasize","target":{"node_id":"lesson-learner-taught-slope-v2-001:node:ink-fraction","fragment_id":"lesson-learner-taught-slope-v2-001:node:ink-fraction:fragment:rise"},"emphasis":"focus"},{"action_id":"lesson-learner-taught-slope-v2-001:action:1:3:3","op":"board.emphasize","target":{"node_id":"lesson-learner-taught-slope-v2-001:node:ink-fraction","fragment_id":"lesson-learner-taught-slope-v2-001:node:ink-fraction:fragment:run"},"emphasis":"focus"}],"after_speech":[{"action_id":"lesson-learner-taught-slope-v2-001:action:1:3:4","op":"board.create","node":{"id":"lesson-learner-taught-slope-v2-001:node:neat-fraction","kind":"math","role":"derivation","content":{"fragments":[{"id":"lesson-learner-taught-slope-v2-001:node:neat-fraction:fragment:definition","latex":"m=\\dfrac{\\text{rise}}{\\text{run}}"},{"id":"lesson-learner-taught-slope-v2-001:node:neat-fraction:fragment:substitution","latex":"=\\dfrac{8-2}{4-1}"},{"id":"lesson-learner-taught-slope-v2-001:node:neat-fraction:fragment:result","latex":"=\\dfrac{6}{3}=2"}]},"placement":{"relation":"replaces","anchor":"lesson-learner-taught-slope-v2-001:node:ink-fraction"},"source":{"selection":"sel-card3-all","confirmed_by":"learner"}}},{"action_id":"lesson-learner-taught-slope-v2-001:action:1:3:5","op":"board.focus","focus":{"targets":["lesson-learner-taught-slope-v2-001:node:neat-fraction"],"intent":"compute_slope"}}]}},{"id":"lesson-learner-taught-slope-v2-001:step:teach-slope:beat:card-4-check-graph","narration":{"text":"Now let's check it on the graph. The line goes through A and B, and it goes up 2 every time you go right 1."},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-learner-taught-slope-v2-001:action:1:4:1","op":"board.create","node":{"id":"lesson-learner-taught-slope-v2-001:node:line-plot","kind":"plot","role":"diagram","content":{"title":"The line through A and B","axes":{"x":{"min":-1,"max":6},"y":{"min":-1,"max":10}},"curves":[{"id":"lesson-learner-taught-slope-v2-001:node:line-plot:fragment:line","expression":"2*x","label":"slope 2"}],"points":[{"id":"lesson-learner-taught-slope-v2-001:node:line-plot:fragment:point-a","x":1,"y":2,"label":"A"},{"id":"lesson-learner-taught-slope-v2-001:node:line-plot:fragment:point-b","x":4,"y":8,"label":"B"}]},"placement":{"relation":"right_of","align":"center","gap":"spacious","anchor":"lesson-learner-taught-slope-v2-001:node:grid"}}},{"action_id":"lesson-learner-taught-slope-v2-001:action:1:4:2","op":"teacher.point","target":{"node_id":"lesson-learner-taught-slope-v2-001:node:line-plot","fragment_id":"lesson-learner-taught-slope-v2-001:node:line-plot:fragment:line"}},{"action_id":"lesson-learner-taught-slope-v2-001:action:1:4:3","op":"board.connect","connection":{"id":"lesson-learner-taught-slope-v2-001:connection:slope-to-line","from":{"node_id":"lesson-learner-taught-slope-v2-001:node:neat-fraction","fragment_id":"lesson-learner-taught-slope-v2-001:node:neat-fraction:fragment:result"},"to":{"node_id":"lesson-learner-taught-slope-v2-001:node:line-plot","fragment_id":"lesson-learner-taught-slope-