{"dsl":"octos.lesson","version":"0.1","profile":"canonical","event":"lesson.step","lesson_id":"lesson-learner-taught-slope-v2-001","sequence":1,"step":{"id":"lesson-learner-taught-slope-v2-001:step:teach-slope","purpose":"Jordan explains slope as steepness, then computes it from two points and checks it on a graph","beats":[{"id":"lesson-learner-taught-slope-v2-001:step:teach-slope:beat:card-1-what-is-slope","narration":{"text":"Slope is how steep a line is. Like a ramp. A steep ramp has a big slope."},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-learner-taught-slope-v2-001:action:1:1:1","op":"board.create","node":{"id":"lesson-learner-taught-slope-v2-001:node:ink-ramps","kind":"ink","role":"example","content":{"snapshot_id":"ink-snap:card1@v4","sha256":"25900c0d2d9c6a24512e2410eaa4a795c80baee6e41702f6b32e1c0671fb242f","replay":"stroke_order","alt":"Jordan's hand-drawn ramps: a gentle ramp and a steep ramp","selections":[{"id":"lesson-learner-taught-slope-v2-001:node:ink-ramps:fragment:gentle-ramp","selection_id":"sel-card1-gentle","label":"gentle ramp"},{"id":"lesson-learner-taught-slope-v2-001:node:ink-ramps:fragment:steep-ramp","selection_id":"sel-card1-steep","label":"steep ramp"}]},"placement":{"relation":"new_region","region_role":"lesson-origin"}}},{"action_id":"lesson-learner-taught-slope-v2-001:action:1:1:2","op":"teacher.point","target":{"node_id":"lesson-learner-taught-slope-v2-001:node:ink-ramps","fragment_id":"lesson-learner-taught-slope-v2-001:node:ink-ramps:fragment:steep-ramp"}}],"after_speech":[{"action_id":"lesson-learner-taught-slope-v2-001:action:1:1:3","op":"board.focus","focus":{"targets":["lesson-learner-taught-slope-v2-001:node:ink-ramps"],"intent":"compare_ramp_steepness"}}]}},{"id":"lesson-learner-taught-slope-v2-001:step:teach-slope:beat:card-2-pick-points","narration":{"text":"Let's pick two points on a line. Point A is at 1 comma 2, and point B is at 4 comma 8."},"stage":{"before_speech":[],"during_speech":[{"action_