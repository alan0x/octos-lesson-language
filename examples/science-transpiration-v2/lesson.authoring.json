{
  "dsl": "octos.lesson",
  "version": "0.1",
  "profile": "authoring",
  "lesson": {
    "mode": "explain",
    "language": "zh-CN",
    "title": "塑料袋里的水珠从哪里来：用对照实验理解蒸腾作用",
    "goals": [
      "从图片中区分直接观察与科学推断",
      "用有叶和无叶装置的差异判断水珠与叶片有关",
      "说清水从土壤到袋内水珠的完整路径"
    ],
    "adaptation": {
      "strategies": ["observe-before-explain", "controlled-comparison", "one-change-per-beat", "evidence-to-model"]
    }
  },
  "steps": [
    {
      "key": "establish-observation",
      "purpose": "先呈现实验与问题，不提前给出蒸腾作用结论",
      "beats": [
        {
          "key": "show-experiment-and-question",
          "say": "先不急着解释，只看这组对照实验。左边是有叶植物，右边是无叶枝条，两边都套着透明塑料袋。我们要回答：左边袋内的水珠从哪里来？",
          "delivery": "patient",
          "actions": [
            {
              "do": "write",
              "as": "experiment-image",
              "kind": "image",
              "role": "evidence",
              "content": {
                "asset_id": "asset-transpiration-control-001",
                "alt": "左侧有叶植物袋内有大量水珠，右侧无叶对照袋内近乎无水珠",
                "regions": [
                  {"as": "leafy-setup", "source_region": "asset-transpiration-control-001#region-leafy-setup", "label": "有叶装置", "confidence": "high"},
                  {"as": "droplets", "source_region": "asset-transpiration-control-001#region-droplets", "label": "袋内水珠", "confidence": "high"},
                  {"as": "leaves", "source_region": "asset-transpiration-control-001#region-leaves", "label": "叶片", "confidence": "high"},
                  {"as": "control-setup", "source_region": "asset-transpiration-control-001#region-control-setup", "label": "无叶对照", "confidence": "high"},
                  {"as": "control-bag", "source_region": "asset-transpiration-control-001#region-control-bag", "label": "近乎无水珠", "confidence": "high"}
                ]
              },
              "place": {"relation": "new_region", "region_role": "lesson-origin"}
            },
            {
              "do": "write",
              "as": "question-card",
              "kind": "note",
              "role": "task",
              "content": {"title": "① 核心问题", "text": "为什么有叶装置的袋内出现很多水珠，而无叶对照几乎没有？"},
              "place": {"relation": "right_of", "anchor": "experiment-image", "align": "center", "gap": "normal"}
            },
            {"do": "group", "as": "experiment-group", "role": "task", "label": "① 先看实验，不猜答案", "members": ["experiment-image", "question-card"]},
            {"do": "focus", "when": "after_speech", "targets": ["experiment-group"], "intent": "inspect_experiment_without_answer"}
          ]
        },
        {
          "key": "observe-left-droplets",
          "say": "先记录左边能直接看到的事实：有叶植物外的袋子内壁有大量水珠。这里只写观察，不写原因。",
          "delivery": "careful",
          "actions": [
            {"do": "emphasize", "target": "experiment-image#droplets", "emphasis": "focus"},
            {"do": "emphasize", "target": "experiment-image#leaves", "emphasis": "supporting"},
            {
              "do": "write",
              "as": "evidence-table",
              "kind": "table",
              "role": "evidence",
              "content": {
                "title": "② 只记录看到的现象",
                "columns": ["装置", "叶片", "袋内水珠"],
                "rows": [["左侧", "有叶", "很多"]]
              },
              "place": {"relation": "below", "anchor": "question-card", "align": "start", "gap": "normal"}
            },
            {"do": "focus", "when": "after_speech", "targets": ["experiment-image", "evidence-table"], "intent": "record_left_observation"}
          ]
        },
        {
          "key": "compare-leafless-control",
          "say": "再看右边对照：枝条没有叶片，塑料袋内几乎没有水珠。两边条件相近，最明显的差别是有没有叶片。",
          "delivery": "patient",
          "actions": [
            {"do": "emphasize", "target": "experiment-image#droplets", "emphasis": "resolved"},
            {"do": "emphasize", "target": "experiment-image#leaves", "emphasis": "resolved"},
            {"do": "emphasize", "target": "experiment-image#control-setup", "emphasis": "focus"},
            {"do": "emphasize", "target": "experiment-image#control-bag", "emphasis": "focus"},
            {
              "do": "revise",
              "target": "evidence-table",
              "reason": "加入无叶对照的直接观察",
              "content": {
                "title": "② 两个装置的直接观察",
                "columns": ["装置", "叶片", "袋内水珠"],
                "rows": [["左侧", "有叶", "很多"], ["右侧", "无叶", "几乎没有"]]
              }
            },
            {"do": "focus", "when": "after_speech", "targets": ["experiment-image", "evidence-table"], "intent": "compare_control_observation"}
          ]
        },
        {
          "key": "infer-leaf-relationship",
          "say": "现在才做第一层推断：有叶时水珠多，无叶时水珠少，说明水珠的形成与叶片有关。注意，这个比较还没有直接展示水在植物内部怎样移动。",
          "delivery": "emphatic",
          "actions": [
            {"do": "emphasize", "target": "experiment-image#leafy-setup", "emphasis": "focus"},
            {"do": "emphasize", "target": "experiment-image#control-setup", "emphasis": "focus"},
            {
              "do": "write",
              "as": "first-inference",
              "kind": "note",
              "role": "inference",
              "content": {
                "title": "③ 由对照得到的推断",
                "text": "有叶 → 水珠多；无叶 → 水珠少。因此，水珠的形成与叶片有关。",
                "details": ["这是由比较得到的推断", "内部运输过程还需要科学模型解释"]
              },
              "place": {"relation": "below", "anchor": "evidence-table", "align": "start", "gap": "normal"}
            },
            {"do": "focus", "when": "after_speech", "targets": ["evidence-table", "first-inference"], "intent": "separate_inference_from_observation"}
          ]
        }
      ]
    },
    {
      "key": "build-mechanism",
      "purpose": "分三步建立植物体内水分运输与蒸腾模型",
      "beats": [
        {
          "key": "absorb-water-through-roots",
          "say": "下面用科学模型解释图片看不到的内部过程。第一步，土壤中的水被根吸收，进入植物体内。",
          "delivery": "patient",
          "actions": [
            {
              "do": "write",
              "as": "water-path",
              "kind": "diagram",
              "role": "mechanism",
              "content": {"title": "④ 水在植物体内的路径", "sequence": ["土壤中的水", "根吸收"]},
              "place": {"relation": "below", "anchor": "first-inference", "align": "start", "gap": "spacious"}
            },
            {"do": "focus", "when": "after_speech", "targets": ["water-path"], "intent": "model_root_absorption"}
          ]
        },
        {
          "key": "transport-water-to-leaves",
          "say": "第二步，水沿着茎内的导管向上运输，最后到达叶片。根吸收和茎运输把土壤里的水送到了叶子。",
          "delivery": "patient",
          "actions": [
            {
              "do": "revise",
              "target": "water-path",
              "reason": "加入茎内运输和到达叶片",
              "content": {"title": "④ 水在植物体内的路径", "sequence": ["土壤中的水", "根吸收", "茎内导管运输", "到达叶片"]}
            },
            {"do": "focus", "when": "after_speech", "targets": ["water-path"], "intent": "model_stem_transport"}
          ]
        },
        {
          "key": "release-water-vapor",
          "say": "第三步，叶片上的气孔把一部分水以水蒸气的形式释放到空气中。这个过程叫蒸腾作用。水离开叶片时还是看不见的水蒸气。",
          "delivery": "emphatic",
          "actions": [
            {
              "do": "revise",
              "target": "water-path",
              "reason": "加入气孔释放水蒸气并命名蒸腾作用",
              "content": {"title": "④ 植物的蒸腾作用", "sequence": ["土壤中的水", "根吸收", "茎内导管运输", "到达叶片", "气孔释放", "水蒸气"]}
            },
            {"do": "focus", "when": "after_speech", "targets": ["water-path"], "intent": "name_transpiration"}
          ]
        },
        {
          "key": "condense-on-bag",
          "say": "水蒸气碰到较凉的塑料袋内壁，会凝结成可见的小水滴。所以我们看到的水珠不是叶片直接吐出的液滴，而是水蒸气后来凝结形成的。",
          "delivery": "careful",
          "actions": [
            {
              "do": "write",
              "as": "condensation-path",
              "kind": "diagram",
              "role": "mechanism",
              "content": {"title": "⑤ 从水蒸气到水珠", "sequence": ["看不见的水蒸气", "碰到较凉袋壁", "凝结", "可见水珠"]},
              "place": {"relation": "right_of", "anchor": "water-path", "align": "center", "gap": "spacious"}
            },
            {"do": "connect", "as": "vapor-to-condensation", "from": "water-path", "to": "condensation-path", "relation": "continues_as", "label": "离开叶片以后"},
            {"do": "focus", "when": "after_speech", "targets": ["condensation-path"], "intent": "explain_condensation"}
          ]
        }
      ]
    },
    {
      "key": "test-and-organize-explanation",
      "purpose": "回到原图检验模型，并区分证据、推断和解释",
      "beats": [
        {
          "key": "return-to-experiment",
          "say": "现在用模型回看实验。有叶装置能通过许多气孔释放水蒸气，所以袋内水珠多；无叶对照缺少主要蒸腾表面，所以水珠很少。模型正好解释了两边的差异。",
          "delivery": "emphatic",
          "actions": [
            {"do": "emphasize", "target": "experiment-image#leafy-setup", "emphasis": "focus"},
            {"do": "emphasize", "target": "experiment-image#control-setup", "emphasis": "supporting"},
            {
              "do": "write",
              "as": "model-check",
              "kind": "note",
              "role": "conclusion",
              "content": {
                "title": "⑥ 用模型解释对照结果",
                "items": ["有叶：气孔多 → 水蒸气多 → 水珠多", "无叶：主要蒸腾表面少 → 水珠少"]
              },
              "place": {"relation": "below", "anchor": "experiment-image", "align": "start", "gap": "normal"}
            },
            {"do": "focus", "when": "after_speech", "targets": ["experiment-image", "model-check"], "intent": "check_model_against_image"}
          ]
        },
        {
          "key": "separate-evidence-and-model",
          "say": "把三层信息分开：图片直接提供观察；有叶和无叶的比较支持推断；根、导管、气孔和凝结组成解释机制。好的科学解释不会把推断冒充成直接看到的事实。",
          "delivery": "careful",
          "actions": [
            {
              "do": "write",
              "as": "reasoning-layers",
              "kind": "table",
              "role": "summary",
              "content": {
                "title": "⑦ 证据怎样支持解释",
                "columns": ["层次", "内容", "依据"],
                "rows": [
                  ["观察", "有叶袋水珠多；无叶袋水珠少", "图片直接可见"],
                  ["推断", "水珠形成与叶片有关", "对照比较"],
                  ["机制", "根吸水→茎运输→气孔释放→凝结", "科学模型"]
                ]
              },
              "place": {"relation": "below", "anchor": "water-path", "align": "start", "gap": "spacious"}
            },
            {"do": "focus", "when": "after_speech", "targets": ["reasoning-layers"], "intent": "distinguish_evidence_inference_mechanism"}
          ]
        },
        {
          "key": "show-complete-route",
          "say": "最后从头复述：先观察两个装置，再用对照发现水珠与叶片有关；接着用根吸水、茎运输、气孔释放水蒸气和袋壁凝结解释水珠。这个完整过程就是从证据走向科学模型。",
          "delivery": "encouraging",
          "actions": [
            {
              "do": "write",
              "as": "lesson-route",
              "kind": "diagram",
              "role": "summary",
              "content": {"title": "⑧ 整条探究路线", "sequence": ["观察水珠", "比较有叶/无叶", "推断与叶片有关", "建立蒸腾模型", "解释对照结果"]},
              "place": {"relation": "below", "anchor": "reasoning-layers", "align": "start", "gap": "spacious"}
            },
            {
              "do": "write",
              "as": "takeaway",
              "kind": "note",
              "role": "summary",
              "content": {"title": "一句话结论", "text": "水由根吸收，经茎运到叶片，再以水蒸气从气孔散失；水蒸气在袋壁凝结成水珠。"},
              "place": {"relation": "below", "anchor": "lesson-route", "align": "start", "gap": "normal"}
            },
            {"do": "group", "as": "summary-group", "role": "summary", "label": "从证据复述到模型", "members": ["lesson-route", "takeaway"]},
            {"do": "focus", "when": "after_speech", "targets": ["summary-group"], "intent": "review_evidence_to_model"}
          ]
        }
      ]
    }
  ],
  "close": {
    "summary": "对照实验支持水珠与叶片有关；根吸水、茎运输、气孔蒸腾和袋壁凝结解释了水珠来源",
    "focus": ["summary-group"]
  }
}
