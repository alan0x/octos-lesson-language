{
  "dsl": "octos.lesson",
  "version": "0.1",
  "profile": "authoring",
  "lesson": {
    "mode": "explain",
    "language": "en-US",
    "title": "Finding slope from two points",
    "goals": [
      "Find the slope from any two points"
    ],
    "adaptation": {
      "strategies": ["learner-taught", "one-card-per-beat"]
    }
  },
  "steps": [
    {
      "key": "teach-slope",
      "purpose": "Jordan explains slope as steepness, then computes it from two points and checks it on a graph",
      "beats": [
        {
          "key": "card-1-what-is-slope",
          "say": "Slope is how steep a line is. Like a ramp. A steep ramp has a big slope.",
          "actions": [
            {
              "do": "write",
              "as": "ink-ramps",
              "kind": "image",
              "role": "example",
              "content": {
                "asset_id": "asset-learner-ink-card1",
                "alt": "Jordan's hand-drawn ramps: a gentle ramp and a steep ramp",
                "regions": [
                  {"as": "gentle-ramp", "source_region": "asset-learner-ink-card1#region-gentle-ramp", "label": "gentle ramp", "confidence": "high"},
                  {"as": "steep-ramp", "source_region": "asset-learner-ink-card1#region-steep-ramp", "label": "steep ramp", "confidence": "high"}
                ]
              },
              "place": {"relation": "new_region", "region_role": "lesson-origin"}
            },
            {"do": "point", "target": "ink-ramps#steep-ramp"},
            {"do": "focus", "when": "after_speech", "targets": ["ink-ramps"], "intent": "compare_ramp_steepness"}
          ]
        },
        {
          "key": "card-2-pick-points",
          "say": "Let's pick two points on a line. Point A is at 1 comma 2, and point B is at 4 comma 8.",
          "actions": [
            {
              "do": "write",
              "as": "grid",
              "kind": "geometry",
              "role": "diagram",
              "content": {
                "title": "Two points",
                "axes": {
                  "x": {"min": -1, "max": 6, "label": "x"},
                  "y": {"min": -1, "max": 9, "label": "y"},
                  "equal_scale": true
                },
                "points": [
                  {"as": "point-a", "x": 1, "y": 2, "label": "A (1, 2)"},
                  {"as": "point-b", "x": 4, "y": 8, "label": "B (4, 8)"}
                ]
              },
              "place": {"relation": "right_of", "anchor": "ink-ramps", "align": "center", "gap": "spacious"}
            },
            {"do": "point", "target": "grid#point-a"},
            {"do": "point", "target": "grid#point-b"},
            {"do": "focus", "when": "after_speech", "targets": ["grid"], "intent": "show_two_points"}
          ]
        },
        {
          "key": "card-3-rise-over-run",
          "say": "Rise is 8 minus 2, which is 6. Run is 4 minus 1, which is 3. So the slope is 6 over 3, which is 2.",
          "actions": [
            {
              "do": "write",
              "as": "ink-fraction",
              "kind": "image",
              "role": "derivation",
              "content": {
                "asset_id": "asset-learner-ink-card3",
                "alt": "Jordan's handwritten fraction: 8 minus 2 over 4 minus 1",
                "regions": [
                  {"as": "rise", "source_region": "asset-learner-ink-card3#region-rise", "label": "8 − 2", "confidence": "high"},
                  {"as": "run", "source_region": "asset-learner-ink-card3#region-run", "label": "4 − 1", "confidence": "high"}
                ]
              },
              "place": {"relation": "below", "anchor": "grid", "align": "start", "gap": "normal"}
            },
            {"do": "emphasize", "target": "ink-fraction#rise", "emphasis": "focus"},
            {"do": "emphasize", "target": "ink-fraction#run", "emphasis": "focus"},
            {
              "do": "write",
              "as": "neat-fraction",
              "kind": "math",
              "role": "derivation",
              "content": {
                "fragments": [
                  {"as": "definition", "latex": "m=\\dfrac{\\text{rise}}{\\text{run}}"},
                  {"as": "substitution", "latex": "=\\dfrac{8-2}{4-1}"},
                  {"as": "result", "latex": "=\\dfrac{6}{3}=2"}
                ],
                "caption": "Made neat from Jordan's handwriting"
              },
              "place": {"relation": "below", "anchor": "ink-fraction", "align": "start", "gap": "compact"}
            },
            {"do": "focus", "when": "after_speech", "targets": ["neat-fraction"], "intent": "compute_slope"}
          ]
        },
        {
          "key": "card-4-check-graph",
          "say": "Now let's check it on the graph. The line goes through A and B, and it goes up 2 every time you go right 1.",
          "actions": [
            {
              "do": "write",
              "as": "line-plot",
              "kind": "plot",
              "role": "diagram",
              "content": {
                "title": "The line through A and B",
                "axes": {"x": {"min": -1, "max": 6}, "y": {"min": -1, "max": 10}},
                "curves": [{"as": "line", "expression": "2*x", "label": "slope 2"}],
                "points": [
                  {"as": "point-a", "x": 1, "y": 2, "label": "A"},
                  {"as": "point-b", "x": 4, "y": 8, "label": "B"}
                ]
              },
              "place": {"relation": "right_of", "anchor": "grid", "align": "center", "gap": "spacious"}
            },
            {"do": "point", "target": "line-plot#line"},
            {"do": "connect", "as": "slope-to-line", "from": "neat-fraction#result", "to": "line-plot#line", "relation": "determines", "label": "slope 2"},
            {"do": "focus", "when": "after_speech", "targets": ["line-plot"], "intent": "check_slope_on_graph"}
          ]
        }
      ]
    }
  ],
  "close": {
    "summary": "Slope is steepness: rise over run. From A (1, 2) to B (4, 8), rise 6 over run 3 gives slope 2, and the graph agrees.",
    "focus": ["neat-fraction", "line-plot"]
  }
}
