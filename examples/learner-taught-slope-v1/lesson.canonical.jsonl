{"dsl":"octos.lesson","version":"0.1","profile":"canonical","event":"lesson.step","lesson_id":"lesson-learner-taught-slope-v1-001","sequence":1,"step":{"id":"lesson-learner-taught-slope-v1-001:step:teach-slope","purpose":"Jordan explains slope as steepness, then computes it from two points and checks it on a graph","beats":[{"id":"lesson-learner-taught-slope-v1-001:step:teach-slope:beat:card-1-what-is-slope","narration":{"text":"Slope is how steep a line is. Like a ramp. A steep ramp has a big slope."},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-learner-taught-slope-v1-001:action:1:1:1","op":"board.create","node":{"id":"lesson-learner-taught-slope-v1-001:node:ink-ramps","kind":"image","role":"example","content":{"asset_id":"asset-learner-ink-card1","alt":"Jordan's hand-drawn ramps: a gentle ramp and a steep ramp","regions":[{"id":"lesson-learner-taught-slope-v1-001:node:ink-ramps:fragment:gentle-ramp","source_region":"asset-learner-ink-card1#region-gentle-ramp","label":"gentle ramp","confidence":"high"},{"id":"lesson-learner-taught-slope-v1-001:node:ink-ramps:fragment:steep-ramp","source_region":"asset-learner-ink-card1#region-steep-ramp","label":"steep ramp","confidence":"high"}]},"placement":{"relation":"new_region","region_role":"lesson-origin"}}},{"action_id":"lesson-learner-taught-slope-v1-001:action:1:1:2","op":"teacher.point","target":{"node_id":"lesson-learner-taught-slope-v1-001:node:ink-ramps","fragment_id":"lesson-learner-taught-slope-v1-001:node:ink-ramps:fragment:steep-ramp"}}],"after_speech":[{"action_id":"lesson-learner-taught-slope-v1-001:action:1:1:3","op":"board.focus","focus":{"targets":["lesson-learner-taught-slope-v1-001:node:ink-ramps"],"intent":"compare_ramp_steepness"}}]}},{"id":"lesson-learner-taught-slope-v1-001:step:teach-slope:beat:card-2-pick-points","narration":{"text":"Let's pick two points on a line. Point A is at 1 comma 2, and point B is at 4 comma 8."},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-learner-taught-slope-v1-001:action:1:2:1","op":"board.create","node":{"id":"lesson-learner-taught-slope-v1-001:node:grid","kind":"geometry","role":"diagram","content":{"title":"Two points","axes":{"x":{"min":-1,"max":6,"label":"x"},"y":{"min":-1,"max":9,"label":"y"},"equal_scale":true},"points":[{"id":"lesson-learner-taught-slope-v1-001:node:grid:fragment:point-a","x":1,"y":2,"label":"A (1, 2)"},{"id":"lesson-learner-taught-slope-v1-001:node:grid:fragment:point-b","x":4,"y":8,"label":"B (4, 8)"}]},"placement":{"relation":"right_of","align":"center","gap":"spacious","anchor":"lesson-learner-taught-slope-v1-001:node:ink-ramps"}}},{"action_id":"lesson-learner-taught-slope-v1-001:action:1:2:2","op":"teacher.point","target":{"node_id":"lesson-learner-taught-slope-v1-001:node:grid","fragment_id":"lesson-learner-taught-slope-v1-001:node:grid:fragment:point-a"}},{"action_id":"lesson-learner-taught-slope-v1-001:action:1:2:3","op":"teacher.point","target":{"node_id":"lesson-learner-taught-slope-v1-001:node:grid","fragment_id":"lesson-learner-taught-slope-v1-001:node:grid:fragment:point-b"}}],"after_speech":[{"action_id":"lesson-learner-taught-slope-v1-001:action:1:2:4","op":"board.focus","focus":{"targets":["lesson-learner-taught-slope-v1-001:node:grid"],"intent":"show_two_points"}}]}},{"id":"lesson-learner-taught-slope-v1-001:step:teach-slope:beat:card-3-rise-over-run","narration":{"text":"Rise is 8 minus 2, which is 6. Run is 4 minus 1, which is 3. So the slope is 6 over 3, which is 2."},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-learner-taught-slope-v1-001:action:1:3:1","op":"board.create","node":{"id":"lesson-learner-taught-slope-v1-001:node:ink-fraction","kind":"image","role":"derivation","content":{"asset_id":"asset-learner-ink-card3","alt":"Jordan's handwritten fraction: 8 minus 2 over 4 minus 1","regions":[{"id":"lesson-learner-taught-slope-v1-001:node:ink-fraction:fragment:rise","source_region":"asset-learner-ink-card3#region-rise","label":"8 − 2","confidence":"high"},{"id":"lesson-learner-taught-slope-v1-001:node:ink-fraction:fragment:run","source_region":"asset-learner-ink-card3#region-run","label":"4 − 1","confidence":"high"}]},"placement":{"relation":"below","align":"start","gap":"normal","anchor":"lesson-learner-taught-slope-v1-001:node:grid"}}},{"action_id":"lesson-learner-taught-slope-v1-001:action:1:3:2","op":"board.emphasize","target":{"node_id":"lesson-learner-taught-slope-v1-001:node:ink-fraction","fragment_id":"lesson-learner-taught-slope-v1-001:node:ink-fraction:fragment:rise"},"emphasis":"focus"},{"action_id":"lesson-learner-taught-slope-v1-001:action:1:3:3","op":"board.emphasize","target":{"node_id":"lesson-learner-taught-slope-v1-001:node:ink-fraction","fragment_id":"lesson-learner-taught-slope-v1-001:node:ink-fraction:fragment:run"},"emphasis":"focus"},{"action_id":"lesson-learner-taught-slope-v1-001:action:1:3:4","op":"board.create","node":{"id":"lesson-learner-taught-slope-v1-001:node:neat-fraction","kind":"math","role":"derivation","content":{"fragments":[{"id":"lesson-learner-taught-slope-v1-001:node:neat-fraction:fragment:definition","latex":"m=\\dfrac{\\text{rise}}{\\text{run}}"},{"id":"lesson-learner-taught-slope-v1-001:node:neat-fraction:fragment:substitution","latex":"=\\dfrac{8-2}{4-1}"},{"id":"lesson-learner-taught-slope-v1-001:node:neat-fraction:fragment:result","latex":"=\\dfrac{6}{3}=2"}],"caption":"Made neat from Jordan's handwriting"},"placement":{"relation":"below","align":"start","gap":"compact","anchor":"lesson-learner-taught-slope-v1-001:node:ink-fraction"}}}],"after_speech":[{"action_id":"lesson-learner-taught-slope-v1-001:action:1:3:5","op":"board.focus","focus":{"targets":["lesson-learner-taught-slope-v1-001:node:neat-fraction"],"intent":"compute_slope"}}]}},{"id":"lesson-learner-taught-slope-v1-001:step:teach-slope:beat:card-4-check-graph","narration":{"text":"Now let's check it on the graph. The line goes through A and B, and it goes up 2 every time you go right 1."},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-learner-taught-slope-v1-001:action:1:4:1","op":"board.create","node":{"id":"lesson-learner-taught-slope-v1-001:node:line-plot","kind":"plot","role":"diagram","content":{"title":"The line through A and B","axes":{"x":{"min":-1,"max":6},"y":{"min":-1,"max":10}},"curves":[{"id":"lesson-learner-taught-slope-v1-001:node:line-plot:fragment:line","expression":"2*x","label":"slope 2"}],"points":[{"id":"lesson-learner-taught-slope-v1-001:node:line-plot:fragment:point-a","x":1,"y":2,"label":"A"},{"id":"lesson-learner-taught-slope-v1-001:node:line-plot:fragment:point-b","x":4,"y":8,"label":"B"}]},"placement":{"relation":"right_of","align":"center","gap":"spacious","anchor":"lesson-learner-taught-slope-v1-001:node:grid"}}},{"action_id":"lesson-learner-taught-slope-v1-001:action:1:4:2","op":"teacher.point","target":{"node_id":"lesson-learner-taught-slope-v1-001:node:line-plot","fragment_id":"lesson-learner-taught-slope-v1-001:node:line-plot:fragment:line"}},{"action_id":"lesson-learner-taught-slope-v1-001:action:1:4:3","op":"board.connect","connection":{"id":"lesson-learner-taught-slope-v1-001:connection:slope-to-line","from":{"node_id":"lesson-learner-taught-slope-v1-001:node:neat-fraction","fragment_id":"lesson-learner-taught-slope-v1-001:node:neat-fraction:fragment:result"},"to":{"node_id":"lesson-learner-taught-slope-v1-001:node:line-plot","fragment_id":"lesson-learner-taught-slope-v1-001:node:line-plot:fragment:line"},"relation":"determines","label":"slope 2"}}],"after_speech":[{"action_id":"lesson-learner-taught-slope-v1-001:action:1:4:4","op":"board.focus","focus":{"targets":["lesson-learner-taught-slope-v1-001:node:line-plot"],"intent":"check_slope_on_graph"}}]}}]}}
