{"dsl":"octos.lesson","version":"0.1","profile":"canonical","event":"lesson.step","lesson_id":"lesson-english-001","sequence":3,"step":{"id":"lesson-english-001:step:explain-relative-clause","purpose":"说明定语从句修饰 book，并拆解其内部结构","beats":[{"id":"lesson-english-001:step:explain-relative-clause:beat:attach-clause-to-book","narration":{"text":"that you gave me 紧跟在 book 后面，用来限定是哪一本书，所以整个从句修饰 book。它相当于中文里的‘你给我的’。","delivery":"neutral"},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-english-001:action:3:1:1","op":"board.connect","connection":{"id":"lesson-english-001:connection:clause-modifies-book","from":{"node_id":"lesson-english-001:node:original-sentence","fragment_id":"lesson-english-001:node:original-sentence:fragment:relative-clause"},"to":{"node_id":"lesson-english-001:node:original-sentence","fragment_id":"lesson-english-001:node:original-sentence:fragment:subject-head"},"relation":"modifies","label":"定语从句修饰先行词 book"}},{"action_id":"lesson-english-001:action:3:1:2","op":"board.create","node":{"id":"lesson-english-001:node:modifier-note","kind":"note","role":"definition","content":{"text":"that you gave me = 你给我的；先行词是 book"},"placement":{"relation":"right_of","align":"center","gap":"spacious","anchor":"lesson-english-001:node:original-sentence"}}}],"after_speech":[]}},{"id":"lesson-english-001:step:explain-relative-clause:beat:split-inner-clause","narration":{"text":"再看从句内部：you 是主语，gave 是谓语，me 是间接宾语；that 代替前面的 book，在 gave 后面充当直接宾语。","delivery":"careful"},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-english-001:action:3:2:1","op":"board.create","node":{"id":"lesson-english-001:node:relative-structure","kind":"text","role":"derivation","content":{"fragments":[{"id":"lesson-english-001:node:relative-structure:fragment:relative-pronoun","text":"that"},{"id":"lesson-english-001:node:relative-structure:fragment:inner-subject","text":" you"},{"id":"lesson-english-001:node:relative-structure:fragment:inner-verb","text":" gave"},{"id":"