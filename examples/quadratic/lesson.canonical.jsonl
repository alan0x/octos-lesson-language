{"dsl":"octos.lesson","version":"0.1","profile":"canonical","event":"lesson.step","lesson_id":"lesson-quadratic-001","sequence":1,"step":{"id":"lesson-quadratic-001:step:establish-goal","purpose":"呈现原题，并说明顶点式能直接暴露图像信息","beats":[{"id":"lesson-quadratic-001:step:establish-goal:beat:write-problem","narration":{"text":"我们先把原式写下来。目标不是只做一次代数变形，而是把它改成能直接看出顶点的形式。","delivery":"neutral"},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-quadratic-001:action:1:1:1","op":"board.create","node":{"id":"lesson-quadratic-001:node:original","kind":"math","role":"problem","content":{"fragments":[{"id":"lesson-quadratic-001:node:original:fragment:lhs","latex":"y="},{"id":"lesson-quadratic-001:node:original:fragment:quadratic","latex":"x^2"},{"id":"lesson-quadratic-001:node:original:fragment:linear","latex":"+6x"},{"id":"lesson-quadratic-001:node:original:fragment:constant","latex":"+5"}]},"placement":{"relation":"new_region","region_role":"lesson_origin"}}}],"after_speech":[{"action_id":"lesson-quadratic-001:action:1:1:2","op":"board.create","node":{"id":"lesson-quadratic-001:node:target-form","kind":"math","role":"observation","content":{"fragments":[{"id":"lesson-quadratic-001:node:target-form:fragment:template","latex":"y=(x-h)^2+k"}],"caption":"顶点式"},"placement":{"relation":"right_of","align":"center","gap":"spacious","anchor":"lesson-quadratic-001:node:original"}}}]}},{"id":"lesson-quadratic-001:step:establish-goal:beat:preview-meaning","narration":{"text":"写成这个形式以后，括号里的 h 和外面的 k 会告诉我们顶点在哪里。接下来一步一步把原式变成它。","delivery":"encouraging"},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-quadratic-001:action:1:2:1","op":"board.emphasize","target":{"node_id":"lesson-quadratic-001:node:target-form","fragment_id":"lesson-quadratic-001:node:target-form:fragment:template"},"emphasis":"focus"},{"action_id":"lesson-quadratic-001:action:1:2:2","op":"teacher.point","target":{"node_id":"lesson-quadratic-001:node:target-form"}}],"after_speech":[]}}]}}
{"dsl":"octos.lesson","version":"0.1","profile":"canonical","event":"lesson.step","lesson_id":"lesson-quadratic-001","sequence":2,"step":{"id":"lesson-quadratic-001:step:find-square","purpose":"由一次项系数找到需要构造的完全平方","beats":[{"id":"lesson-quadratic-001:step:find-square:beat:focus-linear-term","narration":{"text":"先只看 x² 加 6x。完全平方展开时，中间项来自两倍乘积，所以我们取 6 的一半，得到 3。","delivery":"careful"},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-quadratic-001:action:2:1:1","op":"board.emphasize","target":{"node_id":"lesson-quadratic-001:node:original","fragment_id":"lesson-quadratic-001:node:original:fragment:linear"},"emphasis":"focus"},{"action_id":"lesson-quadratic-001:action:2:1:2","op":"board.create","node":{"id":"lesson-quadratic-001:node:half-coefficient","kind":"math","role":"observation","content":{"fragments":[{"id":"lesson-quadratic-001:node:half-coefficient:fragment:calculation","latex":"6\\div2=3"}],"caption":"一次项系数的一半"},"placement":{"relation":"below","align":"start","gap":"normal","anchor":"lesson-quadratic-001:node:original"}}}],"after_speech":[]}},{"id":"lesson-quadratic-001:step:find-square:beat:construct-identity","narration":{"text":"因此我们需要 3 的平方，也就是 9。这样 x² 加 6x 加 9 正好等于 x 加 3 的平方。","delivery":"emphatic"},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-quadratic-001:action:2:2:1","op":"board.create","node":{"id":"lesson-quadratic-001:node:square-identity","kind":"math","role":"derivation","content":{"fragments":[{"id":"lesson-quadratic-001:node:square-identity:fragment:expanded","latex":"x^2+6x+9"},{"id":"lesson-quadratic-001:node:square-identity:fragment:equals","latex":"="},{"id":"lesson-quadratic-001:node:square-identity:fragment:factored","latex":"(x+3)^2"}]},"placement":{"relation":"below","align":"start","gap":"normal","anchor":"lesson-quadratic-001:node:half-coefficient"}}},{"action_id":"lesson-quadratic-001:action:2:2:2","op":"board.connect","connection":{"id":"lesson-quadratic-001:connection:half-to-square","from":{"node_id":"lesson-quadratic-001:node:half-coefficient","fragment_id":"lesson-quadratic-001:node:half-coefficient:fragment:calculation"},"to":{"node_id":"lesson-quadratic-001:node:square-identity","fragment_id":"lesson-quadratic-001:node:square-identity:fragment:factored"},"relation":"constructs","label":"3 决定括号中的常数"}}],"after_speech":[]}}]}}
{"dsl":"octos.lesson","version":"0.1","profile":"canonical","event":"lesson.step","lesson_id":"lesson-quadratic-001","sequence":3,"step":{"id":"lesson-quadratic-001:step:preserve-equality","purpose":"显式展示加9减9，避免遗漏常数项","beats":[{"id":"lesson-quadratic-001:step:preserve-equality:beat:add-and-subtract-nine","narration":{"text":"但原式里本来没有这个 9。为了不改变函数，我们必须同时加上 9，再减去 9。","delivery":"careful"},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-quadratic-001:action:3:1:1","op":"board.create","node":{"id":"lesson-quadratic-001:node:balanced-expression","kind":"math","role":"derivation","content":{"fragments":[{"id":"lesson-quadratic-001:node:balanced-expression:fragment:prefix","latex":"y=x^2+6x"},{"id":"lesson-quadratic-001:node:balanced-expression:fragment:add-nine","latex":"+9"},{"id":"lesson-quadratic-001:node:balanced-expression:fragment:subtract-nine","latex":"-9"},{"id":"lesson-quadratic-001:node:balanced-expression:fragment:plus-five","latex":"+5"}]},"placement":{"relation":"below","align":"start","gap":"spacious","anchor":"lesson-quadratic-001:node:square-identity"}}},{"action_id":"lesson-quadratic-001:action:3:1:2","op":"board.emphasize","target":{"node_id":"lesson-quadratic-001:node:balanced-expression","fragment_id":"lesson-quadratic-001:node:balanced-expression:fragment:add-nine"},"emphasis":"supporting"},{"action_id":"lesson-quadratic-001:action:3:1:3","op":"board.emphasize","target":{"node_id":"lesson-quadratic-001:node:balanced-expression","fragment_id":"lesson-quadratic-001:node:balanced-expression:fragment:subtract-nine"},"emphasis":"supporting"},{"action_id":"lesson-quadratic-001:action:3:1:4","op":"board.connect","connection":{"id":"lesson-quadratic-001:connection:cancel-nine","from":{"node_id":"lesson-quadratic-001:node:balanced-expression","fragment_id":"lesson-quadratic-001:node:balanced-expression:fragment:add-nine"},"to":{"node_id":"lesson-quadratic-001:node:balanced-expression","fragment_id":"lesson-quadratic-001:node:balanced-expression:fragment:subtract-nine"},"relation":"cancels","label":"总变化为0"}}],"after_speech":[]}},{"id":"lesson-quadratic-001:step:preserve-equality:beat:combine-result","narration":{"text":"前三项组成 x 加 3 的平方，剩下的负 9 加 5 等于负 4，所以顶点式是 y 等于 x 加 3 的平方减 4。","delivery":"emphatic"},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-quadratic-001:action:3:2:1","op":"board.create","node":{"id":"lesson-quadratic-001:node:vertex-form","kind":"math","role":"conclusion","content":{"fragments":[{"id":"lesson-quadratic-001:node:vertex-form:fragment:lhs","latex":"y="},{"id":"lesson-quadratic-001:node:vertex-form:fragment:square","latex":"(x+3)^2"},{"id":"lesson-quadratic-001:node:vertex-form:fragment:vertical-shift","latex":"-4"}]},"placement":{"relation":"below","align":"start","gap":"normal","anchor":"lesson-quadratic-001:node:balanced-expression"}}},{"action_id":"lesson-quadratic-001:action:3:2:2","op":"board.connect","connection":{"id":"lesson-quadratic-001:connection:identity-to-result","from":{"node_id":"lesson-quadratic-001:node:square-identity","fragment_id":"lesson-quadratic-001:node:square-identity:fragment:factored"},"to":{"node_id":"lesson-quadratic-001:node:vertex-form","fragment_id":"lesson-quadratic-001:node:vertex-form:fragment:square"},"relation":"reused_as","label":"完全平方部分"}}],"after_speech":[]}}]}}
{"dsl":"octos.lesson","version":"0.1","profile":"canonical","event":"lesson.step","lesson_id":"lesson-quadratic-001","sequence":4,"step":{"id":"lesson-quadratic-001:step:interpret-graph","purpose":"从顶点式读出顶点、对称轴和相对 y=x² 的平移","beats":[{"id":"lesson-quadratic-001:step:interpret-graph:beat:draw-parabola","narration":{"text":"现在看图像。让括号等于零时，x 是负 3；此时 y 取得最小值负 4，所以顶点是负 3、负 4。","delivery":"neutral"},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-quadratic-001:action:4:1:1","op":"board.create","node":{"id":"lesson-quadratic-001:node:parabola","kind":"plot","role":"diagram","content":{"axes":{"x":{"min":-8,"max":3},"y":{"min":-6,"max":8}},"curves":[{"id":"lesson-quadratic-001:node:parabola:fragment:main-curve","expression":"(x+3)^2-4","label":"y=(x+3)²-4"}],"points":[{"id":"lesson-quadratic-001:node:parabola:fragment:vertex","x":-3,"y":-4,"label":"(-3,-4)"}],"guides":[{"id":"lesson-quadratic-001:node:parabola:fragment:symmetry-axis","kind":"vertical_line","value":-3,"label":"x=-3"}]},"placement":{"relation":"right_of","align":"center","gap":"spacious","anchor":"lesson-quadratic-001:node:balanced-expression"}}},{"action_id":"lesson-quadratic-001:action:4:1:2","op":"teacher.point","target":{"node_id":"lesson-quadratic-001:node:parabola","fragment_id":"lesson-quadratic-001:node:parabola:fragment:vertex"}},{"action_id":"lesson-quadratic-001:action:4:1:3","op":"board.connect","connection":{"id":"lesson-quadratic-001:connection:square-to-horizontal","from":{"node_id":"lesson-quadratic-001:node:vertex-form","fragment_id":"lesson-quadratic-001:node:vertex-form:fragment:square"},"to":{"node_id":"lesson-quadratic-001:node:parabola","fragment_id":"lesson-quadratic-001:node:parabola:fragment:symmetry-axis"},"relation":"determines","label":"对称轴 x=-3"}},{"action_id":"lesson-quadratic-001:action:4:1:4","op":"board.connect","connection":{"id":"lesson-quadratic-001:connection:constant-to-vertical","from":{"node_id":"lesson-quadratic-001:node:vertex-form","fragment_id":"lesson-quadratic-001:node:vertex-form:fragment:vertical-shift"},"to":{"node_id":"lesson-quadratic-001:node:parabola","fragment_id":"lesson-quadratic-001:node:parabola:fragment:vertex"},"relation":"determines","label":"顶点纵坐标 -4"}}],"after_speech":[]}},{"id":"lesson-quadratic-001:step:interpret-graph:beat:explain-translation","narration":{"text":"和 y 等于 x² 相比，它向左移动 3，再向下移动 4。括号里虽然写加 3，但让括号为零需要 x 等于负 3，所以方向是向左。","delivery":"careful"},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-quadratic-001:action:4:2:1","op":"board.create","node":{"id":"lesson-quadratic-001:node:translation-note","kind":"note","role":"observation","content":{"text":"y=x²  →  左移3  →  下移4","details":["x+3=0 时 x=-3","顶点从 (0,0) 变为 (-3,-4)"]},"placement":{"relation":"below","align":"center","gap":"normal","anchor":"lesson-quadratic-001:node:parabola"}}},{"action_id":"lesson-quadratic-001:action:4:2:2","op":"board.connect","connection":{"id":"lesson-quadratic-001:connection:graph-to-translation","from":{"node_id":"lesson-quadratic-001:node:parabola","fragment_id":"lesson-quadratic-001:node:parabola:fragment:vertex"},"to":{"node_id":"lesson-quadratic-001:node:translation-note"},"relation":"explained_by","label":"平移结果"}}],"after_speech":[]}}]}}
