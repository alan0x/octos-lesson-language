de_id":"lesson-english-v2-001:node:chinese-order","fragment_id":"lesson-english-v2-001:node:chinese-order:fragment:modifier"},"emphasis":"focus"},{"action_id":"lesson-english-v2-001:action:4:2:3","op":"board.emphasize","target":{"node_id":"lesson-english-v2-001:node:chinese-order","fragment_id":"lesson-english-v2-001:node:chinese-order:fragment:noun"},"emphasis":"supporting"}],"after_speech":[{"action_id":"lesson-english-v2-001:action:4:2:4","op":"board.focus","focus":{"targets":["lesson-english-v2-001:node:chinese-order"],"intent":"reorder_for_chinese_meaning"}}]}},{"id":"lesson-english-v2-001:step:restore-meaning:beat:show-complete-route","narration":{"text":"最后从头复述：先圈出 that 从句，拿掉它找到主句；再确认它修饰 book；还原 you gave me the book，才能看出 that 代替 book 作直接宾语；最后把主句与修饰信息重新组合。","delivery":"encouraging"},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-english-v2-001:action:4:3:1","op":"board.create","node":{"id":"lesson-english-v2-001:node:lesson-route","kind":"diagram","role":"summary","content":{"title":"⑦ 拆定语从句的路线","sequence":["圈出从句","拿掉后找主句","找先行词","还原普通句","判断 that 的作用","组合整句含义"]},"placement":{"relation":"below","align":"start","gap":"spacious","anchor":"lesson-english-v2-001:node:chinese-order"}}},{"action_id":"lesson-english-v2-001:action:4:3:2","op":"board.create","node":{"id":"lesson-english-v2-001:node:takeaway","kind":"note","role":"summary","content":{"title":"一句话方法","text":"先拿掉定语从句找主干，再还原普通句判断关系代词在从句中的成分。"},"placement":{"relation":"below","align":"start","gap":"normal","anchor":"lesson-english-v2-001:node:lesson-route"}}},{"action_id":"lesson-english-v2-001:action:4:3:3","op":"board.group","group":{"id":"lesson-english-v2-001:group:summary-group","title":"从这里复述拆句方法","role":"summary","members":["lesson-english-v2-001:node:lesson-route","lesson-english-v2-001:node:takeaway"]}}],"after_speech":[{"action_id":"lesson-english-v2-001:action:4:3:4","op":"board.focus","focus":{"targets":["lesson-english-v2-001:group:summary-group"],"intent":"review_relative_cla