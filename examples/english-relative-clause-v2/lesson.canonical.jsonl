{"dsl":"octos.lesson","version":"0.1","profile":"canonical","event":"lesson.step","lesson_id":"lesson-english-v2-001","sequence":3,"step":{"id":"lesson-english-v2-001:step:attach-and-reconstruct-clause","purpose":"先确定修饰对象，再用普通句还原关系代词作用","beats":[{"id":"lesson-english-v2-001:step:attach-and-reconstruct-clause:beat:attach-clause-to-book","narration":{"text":"把中间块放回来。它紧跟在名词 book 后面，回答的是哪一本书，所以 that you gave me 修饰 book；book 叫先行词。","delivery":"emphatic"},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-english-v2-001:action:3:1:1","op":"board.emphasize","target":{"node_id":"lesson-english-v2-001:node:original-sentence","fragment_id":"lesson-english-v2-001:node:original-sentence:fragment:relative-clause"},"emphasis":"focus"},{"action_id":"lesson-english-v2-001:action:3:1:2","op":"board.emphasize","target":{"node_id":"lesson-english-v2-001:node:original-sentence","fragment_id":"lesson-english-v2-001:node:original-sentence:fragment:subject-head"},"emphasis":"focus"},{"action_id":"lesson-english-v2-001:action:3:1:3","op":"board.connect","connection":{"id":"lesson-english-v2-001:connection:clause-modifies-book","from":{"node_id":"lesson-english-v2-001:node:original-sentence","fragment_id":"lesson-english-v2-001:node:original-sentence:fragment:relative-clause"},"to":{"node_id":"lesson-english-v2-001:node:original-sentence","fragment_id":"lesson-english-v2-001:node:original-sentence:fragment:subject-head"},"relation":"modifies","label":"修饰先行词 book"}},{"action_id":"lesson-english-v2-001:action:3:1:4","op":"board.create","node":{"id":"lesson-english-v2-001:node:antecedent-note","kind":"note","role":"definition","content":{"title":"④ 修饰关系","text":"that you gave me → book；先行词：book"},"placement":{"relation":"left_of","align":"center","gap":"normal","anchor":"lesson-english-v2-001:node:original-sentence"}}}],"after_speech":[{"action_id":"lesson-english-v2-001:action:3:1:5","op":"board.focus","focus":{"targets":["lesson-english-v2-001:node:original-sentence","lesson-e