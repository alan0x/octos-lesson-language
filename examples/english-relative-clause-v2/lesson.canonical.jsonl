{"dsl":"octos.lesson","version":"0.1","profile":"canonical","event":"lesson.step","lesson_id":"lesson-english-v2-001","sequence":1,"step":{"id":"lesson-english-v2-001:step:establish-sentence","purpose":"呈现完整句子和拆句目标，不提前给语法答案","beats":[{"id":"lesson-english-v2-001:step:establish-sentence:beat:show-sentence-and-goal","narration":{"text":"先完整读这句话：The book that you gave me was fascinating。我们不急着逐词翻译，先找主句，再判断中间那一段在修饰谁。","delivery":"patient"},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-english-v2-001:action:1:1:1","op":"board.create","node":{"id":"lesson-english-v2-001:node:original-sentence","kind":"text","role":"problem","content":{"fragments":[{"id":"lesson-english-v2-001:node:original-sentence:fragment:subject-head","text":"The book "},{"id":"lesson-english-v2-001:node:original-sentence:fragment:relative-clause","text":"that you gave me "},{"id":"lesson-english-v2-001:node:original-sentence:fragment:main-verb","text":"was "},{"id":"lesson-english-v2-001:node:original-sentence:fragment:subject-complement","text":"fascinating."}],"caption":"原句"},"placement":{"relation":"new_region","region_role":"lesson-origin"}}},{"action_id":"lesson-english-v2-001:action:1:1:2","op":"board.create","node":{"id":"lesson-english-v2-001:node:goal-card","kind":"note","role":"task","content":{"title":"① 拆句顺序","items":["先找主句骨架","再找被修饰的词","最后看从句内部作用"]},"placement":{"relation":"right_of","align":"center","gap":"normal","anchor":"lesson-english-v2-001:node:original-sentence"}}},{"action_id":"lesson-english-v2-001:action:1:1:3","op":"board.group","group":{"id":"lesson-english-v2-001:group:task-group","title":"① 先看整句与目标","role":"task","members":["lesson-english-v2-001:node:original-sentence","lesson-english-v2-001:node:goal-card"]}}],"after_speech":[{"action_id":"lesson-english-v2-001:action:1:1:4","op":"board.focus","focus":{"targets":["lesson-english-v2-001:group:task-group"],"intent":"read_sentence_and_goal"}}]}},{"id":"lesson-english-v2-001:step:establish-sentence:beat:bracket-relative-clause","narration":{"text":"先把 that you gave me 看成一个整体。它夹在 book 和主句动词 was 之间，暂时给它加上括号，稍后再打开。","delivery":"careful"},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-english-v2-001:action:1:2:1","op":"board.emphasize","target":{"node_id":"lesson-english-v2-001:node:original-sentence","fragment_id":"lesson-english-v2-001:node:original-sentence:fragment:relative-clause"},"emphasis":"focus"},{"action_id":"lesson-english-v2-001:action:1:2:2","op":"board.create","node":{"id":"lesson-english-v2-001:node:clause-bracket","kind":"note","role":"observation","content":{"title":"② 先圈出一整块","text":"[ that you gave me ] 暂时整体拿开，寻找外层主句。"},"placement":{"relation":"below","align":"start","gap":"normal","anchor":"lesson-english-v2-001:node:goal-card"}}}],"after_speech":[{"action_id":"lesson-english-v2-001:action:1:2:3","op":"board.focus","focus":{"targets":["lesson-english-v2-001:node:original-sentence","lesson-english-v2-001:node:clause-bracket"],"intent":"bracket_middle_clause"}}]}}]}}
